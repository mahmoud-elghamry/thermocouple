{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content firmware/family/test/integration/profile_summary.py; Get-Content firmware/family/src/app/ee_owner.c; Get-Content firmware/family/src/services/settings.c'","aggregated_output":"\"\"\"Report AVR instruction measurements separately from register-model CPU.\"\"\"\r\nfrom pathlib import Path\r\nimport re\r\nimport sys\r\n\r\nroot = Path(sys.argv[1])\r\ntext = (root / \"cycles.log\").read_text()\r\nmcal = (root / \"mcal.log\").read_text()\r\nsoft = [int(b)-int(a) for a,b in re.findall(\r\n    r\"BEGIN 9 \\d+\\n.*?# cycles\\s+(\\d+)\\n.*?END\\n.*?# cycles\\s+(\\d+)\",mcal,re.S)]\r\nassert len(soft)==256\r\nmarker = None\r\nrows = []\r\nstart = fake = io_start = bound = 0\r\ncount = 0\r\n# Conservative -Os MCAL bounds, including call/return margin. Soft SPI is\r\n# calibrated across all 256 TX values in mcal.log (3234 cycles); reserve 3300.\r\ncosts = {1: 400, 2: 100, 3: 100, 4: 60, 6: 30, 7: 30, 8: 110,\r\n         9: max(soft)+16, 10: 100, 11: 40, 12: 300, 13: 300, 14: 100,\r\n         15: 40, 16: 60, 17: 20, 18: 80, 19: 100, 20: 10,\r\n         21: 20, 22: 100, 23: 150, 24: 150, 25: 80, 26: 20,\r\n         27: 100, 28: 100, 29: 100, 30: 80, 31: 60}\r\nfor line in text.splitlines():\r\n    match = re.fullmatch(r\"(BEGIN|END|IO_BEGIN|IO_END)(?: (.*))?\", line)\r\n    if match:\r\n        marker = match[1], list(map(int, (match[2] or \"\").split()))\r\n    match = re.match(r\"# cycles\\s+(\\d+)\", line.strip())\r\n    if not match or not marker:\r\n        continue\r\n    kind, values = marker\r\n    marker = None\r\n    cycles = int(match[1])\r\n    if kind == \"BEGIN\":\r\n        start = cycles\r\n        fake = bound = count = 0\r\n    elif kind == \"IO_BEGIN\":\r\n        io_start = cycles\r\n        io, arg = values\r\n        bound += 16 * arg + 40 if io == 5 else costs[io]\r\n        count += 1\r\n    elif kind == \"IO_END\":\r\n        fake += cycles - io_start + 4  # breakpoint precedes the RET\r\n    elif count:\r\n        application = cycles - start - fake\r\n        # 25% + 2048 cycles reserves Timer2 and full-duplex UART interrupts.\r\n        # Measured Timer2 ISR=716 cycles. At 38400 baud, 2*3840 UART ISRs/s,\r\n        # each <=100 cycles: <19% CPU. This is a running-loop estimate, not\r\n        # exhaustive WCET; failures/timeouts and input-driven branches remain.\r\n        estimate = ((application + bound) * 5 + 3) // 4 + 2048\r\n        rows.append((estimate, application, bound, *values[:2]))\r\nassert rows and \"profile_done\" in text, \"Incomplete simulator run\"\r\nworst = max(rows)\r\nsummary = [\"cycles,production_cpu,mcal_bound,phase,pass\"]\r\nsummary += [\",\".join(map(str, row)) for row in rows]\r\n(root / \"passes.csv\").write_text(\"\\n\".join(summary) + \"\\n\")\r\nprint(f\"AVR running-loop estimate: {worst[0]} cycles / {worst[0]/8000:.3f} ms \"\r\n      f\"(phase {worst[3]}, pass {worst[4]}); 64000-cycle budget EXCEEDED\")\r\nprint(f\"Components: production={worst[1]}, MCAL bound={worst[2]}, \"\r\n      \"interrupt reserve=25% + 2048 cycles\")\r\ncommit = (root / \"commit.log\").read_text()\r\nticks = list(map(int, re.findall(r\"# cycles\\s+(\\d+)\", commit)))\r\nassert len(ticks) == 2, \"Incomplete pure commit measurement\"\r\nassert \"RES_OK\" in commit, \"Pure commit did not start\"\r\nprint(f\"set_commit_with_cal alone: {ticks[1]-ticks[0]} cycles / \"\r\n      f\"{(ticks[1]-ticks[0])/8000:.4f} ms\")\r\nwrap = (root / \"wrap.log\").read_text()\r\nticks = list(map(int, re.findall(r\"# cycles\\s+(\\d+)\", wrap)))\r\nassert len(ticks) == 2, \"Incomplete epoch-wrap measurement\"\r\nassert \"RES_OK\" in wrap, \"Epoch-wrap commit did not start\"\r\nprint(f\"Epoch-wrap commit alone: {ticks[1]-ticks[0]} cycles / \"\r\n      f\"{(ticks[1]-ticks[0])/8000:.4f} ms\")\r\nmcal = (root / \"mcal.log\").read_text()\r\ncalibration = {}\r\nfor kind, _, begin, end in re.findall(\r\n        r\"BEGIN (\\d+) (\\d+)\\n.*?# cycles\\s+(\\d+)\\n.*?END\\n.*?# cycles\\s+(\\d+)\",\r\n        mcal, re.S):\r\n    calibration.setdefault(int(kind), []).append(int(end)-int(begin))\r\nassert len(calibration[9]) == 256 and calibration[32], \"Incomplete MCAL calibration\"\r\nprint(f\"Real soft SPI: {max(calibration[9])} cycles/byte; \"\r\n      f\"30-byte CJ transaction={30*max(calibration[9])} cycles; \"\r\n      f\"Timer2 ISR={max(calibration[32])} cycles\")\r\n#include \"app/ee_owner.h\"\r\n#include \"mcal/eeprom.h\"\r\n#include <string.h>\r\n#define QUEUE_SIZE 32u\r\nstatic set_store_t store;\r\nstatic settings_t *active;\r\nstatic calibration_t *calibration;\r\nstatic calibration_t cal_mailbox;\r\nstatic uint8_t settings_slot,cal_slot,done,head,tail,count;\r\nstatic bool settings_ok,begin_notice,transaction,cal_transaction,cal_saved,io_ok,internal_error,bg_fault;\r\nstatic bool counted,counter_pending,event_pending,loss_alarm;\r\nstatic uint8_t counter_slot,counter_index,event_index,event_slot;\r\nstatic uint8_t load_slot,next_slot;\r\nstatic uint16_t next_sequence;\r\nstatic bool ring_valid;\r\nstatic uint32_t cycles,events_lost;\r\nstatic events_t ring;\r\nstatic event_t queue[QUEUE_SIZE];\r\nstatic ee_op_t operation;\r\nstatic uint32_t read32(uint16_t address) {\r\n    uint8_t i; uint32_t v=0;\r\n    for(i=0;i<4;i++) v|=(uint32_t)ee_read((uint16_t)(address+i))<<(8*i);\r\n    return v;\r\n}\r\nuint8_t *ee_owner_boot_image(void) { return store.image; }\r\nvoid ee_owner_init(settings_t *cfg,calibration_t *cal,uint8_t ss,uint8_t cs,bool valid) {\r\n    uint32_t a,b; bool av,bv;\r\n    active=cfg; calibration=cal; settings_slot=ss; cal_slot=cs; settings_ok=valid;\r\n    done=head=tail=count=0; begin_notice=transaction=cal_transaction=cal_saved=false;\r\n    counted=counter_pending=event_pending=internal_error=bg_fault=false; io_ok=true;\r\n    loss_alarm=false; events_lost=0;\r\n    memset(&operation,0,sizeof operation); set_store_init(&store);\r\n    load_slot=next_slot=0; next_sequence=0; ring_valid=false;\r\n    a=read32(0x10); b=read32(0x18);\r\n    av=(a^read32(0x14))==UINT32_MAX; bv=(b^read32(0x1C))==UINT32_MAX;\r\n    counter_slot=(uint8_t)(bv && (!av || (b!=a && (uint32_t)(b-a)<0x80000000UL)));\r\n    cycles=av || bv?(counter_slot?b:a):0;\r\n}\r\nbool ee_owner_busy(void) { return transaction; }\r\nstore_phase_t ee_owner_phase(void) { return store.phase; }\r\nbool ee_owner_publish_pending(void) {\r\n    return transaction && store.phase==STORE_VERIFY && store.pending && store.index+1u==store.length;\r\n}\r\nbool ee_owner_protection_change(void) { return store.protection_change; }\r\nbool ee_owner_settings_valid(void) { return settings_ok; }\r\nbool ee_owner_cal_saved(void) { return cal_saved; }\r\nbool ee_owner_take_begin(void) { bool b=begin_notice; begin_notice=false; return b; }\r\nuint8_t ee_owner_take_done(void) { uint8_t d=done; done=0; return d; }\r\nfault_code_t ee_owner_fault(void) {\r\n    return internal_error?FC_G04_INTERNAL:store.fault!=FC_NONE?store.fault:ee_owner_info_fault()?FC_G13_SAVE_FAIL_INFO:FC_NONE;\r\n}\r\nbool ee_owner_info_fault(void) { return store.fault==FC_G13_SAVE_FAIL_INFO || bg_fault || loss_alarm; }\r\nuint32_t ee_owner_events_lost(void) { return events_lost; }\r\nbool ee_owner_events_drained(void) { return load_slot==EVENT_SLOTS && count==0 && !event_pending && ee_ready(); }\r\nvoid ee_owner_ack_events(void) { if(ee_owner_events_drained()) loss_alarm=false; }\r\nuint32_t ee_owner_cycles(void) { return cycles; }\r\nstatic bool background_busy(void) { return load_slot<EVENT_SLOTS || counter_pending || event_pending; }\r\nres_t ee_owner_settings(const settings_t *candidate) {\r\n    res_t r;\r\n    if(transaction || background_busy() || !ee_ready()) return RES_BUSY;\r\n    if(!active) return RES_ERR_RANGE;\r\n    r=set_prepare_with_cal(&store,candidate,settings_ok?active:NULL,settings_slot,calibration,cal_slot);\r\n    if(r==RES_OK) { transaction=begin_notice=true; cal_transaction=false; io_ok=true; operation.kind=EE_NONE; }\r\n    return r;\r\n}\r\nres_t ee_owner_calibration(const calibration_t *candidate) {\r\n    res_t r;\r\n    if(transaction || background_busy() || !ee_ready()) return RES_BUSY;\r\n    if(!calibration || !candidate || candidate->bank_count!=calibration->bank_count) return RES_ERR_RANGE;\r\n    cal_mailbox=*candidate;\r\n    r=cal_prepare(&store,&cal_mailbox,calibration->sequence,cal_slot);\r\n    if(r==RES_OK) { transaction=begin_notice=cal_transaction=true; cal_saved=false; io_ok=true; operation.kind=EE_NONE; }\r\n    return r;\r\n}\r\nbool ee_owner_log(const event_t *event) {\r\n    if(!event) { internal_error=true; return false; }\r\n    if(count==QUEUE_SIZE) {\r\n        if(events_lost!=UINT32_MAX) ++events_lost;\r\n        loss_alarm=true; return false;\r\n    }\r\n    queue[head]=*event; queue[head].power_cycles=(uint16_t)(cycles+(counted?0u:1u));\r\n    head=(uint8_t)((head+1u)%QUEUE_SIZE); ++count; return true;\r\n}\r\nvoid ee_owner_validated_scan(fault_code_t reset_code,uint32_t uptime) {\r\n    event_t e;\r\n    if(counted) return;\r\n    counted=true; ++cycles; counter_slot^=1; counter_index=0; counter_pending=true;\r\n    memset(&e,0,sizeof e); e.type=EV_POWER_UP; e.code=reset_code; e.uptime_s=uptime;\r\n    (void)ee_owner_log(&e);\r\n}\r\nstatic void publish(void) {\r\n    /* A wrap can verify calibration before the settings record fails. Publish\r\n     * that verified invalidation even on failure; retries must use its slot. */\r\n    if(store.calibration_slot_known && store.calibration_active_slot!=cal_slot && !cal_transaction) {\r\n        if(cal_unpack(store.wrap_cal_image,calibration->bank_count,calibration)!=RES_OK) internal_error=true;\r\n        else cal_slot=store.calibration_active_slot;\r\n    }\r\n    if(store.phase!=STORE_DONE) return;\r\n    if(cal_transaction) {\r\n        if(cal_unpack(store.image,calibration->bank_count,calibration)!=RES_OK) { internal_error=true; return; }\r\n        cal_slot=store.active_slot; cal_saved=true; done=2;\r\n    } else {\r\n        if(set_unpack(store.image,active->board_type,active->channel_count,active)!=RES_OK) { internal_error=true; return; }\r\n        settings_slot=store.active_slot; settings_ok=true; done=1;\r\n    }\r\n}\r\nvoid ee_owner_step(void) {\r\n    uint8_t value=0; res_t r;\r\n    if(!ee_ready()) return;\r\n    if(load_slot<EVENT_SLOTS) {\r\n        uint8_t i; event_t e;\r\n        for(i=0;i<16;i++) ring.slot[load_slot][i]=ee_read((uint16_t)(0x840+16*load_slot+i));\r\n        if(ev_unpack(ring.slot[load_slot],&e)==RES_OK &&\r\n           (!ring_valid || ((uint16_t)(e.sequence-(uint16_t)(next_sequence-1u))!=0 &&\r\n                            (uint16_t)(e.sequence-(uint16_t)(next_sequence-1u))<0x8000u))) {\r\n            ring_valid=true; next_sequence=(uint16_t)(e.sequence+1u);\r\n            next_slot=(uint8_t)((load_slot+1u)%EVENT_SLOTS);\r\n        }\r\n        ++load_slot; return;\r\n    }\r\n    if(transaction) {\r\n        if(operation.kind==EE_READ) value=ee_read(operation.address);\r\n        set_store_step(&store,true,io_ok,value,&operation); io_ok=true;\r\n        if(operation.kind==EE_WRITE) io_ok=ee_write_byte(operation.address,operation.value)==RES_OK;\r\n        if(store.phase==STORE_DONE || store.phase==STORE_FAILED) {\r\n            publish(); transaction=false;\r\n        }\r\n        return;\r\n    }\r\n    if(counter_pending) {\r\n        uint32_t v=counter_index<4?cycles:~cycles;\r\n        r=ee_write_byte((uint16_t)(0x10+8*counter_slot+counter_index),(uint8_t)(v>>(8*(counter_index%4))));\r\n        if(r==RES_OK) { bg_fault=false; if(++counter_index==8) counter_pending=false; }\r\n        else bg_fault=true;\r\n        return;\r\n    }\r\n    if(!event_pending && count) {\r\n        queue[tail].sequence=next_sequence;\r\n        if(ev_pack(&queue[tail],ring.slot[next_slot])!=RES_OK) { internal_error=true; return; }\r\n        event_slot=next_slot; ++next_sequence; next_slot=(uint8_t)((next_slot+1u)%EVENT_SLOTS);\r\n        event_index=0; event_pending=true;\r\n        tail=(uint8_t)((tail+1u)%QUEUE_SIZE); --count;\r\n    }\r\n    if(event_pending) {\r\n        r=ee_write_byte((uint16_t)(0x840+16*event_slot+event_index),ring.slot[event_slot][event_index]);\r\n        if(r==RES_OK) { bg_fault=false; if(++event_index==16) event_pending=false; }\r\n        else bg_fault=true;\r\n    }\r\n}\r\nres_t ee_owner_scratch(uint16_t address,uint8_t value) {\r\n    if(address<0xF00 || address>=0x1000) return RES_ERR_RANGE;\r\n    if(transaction || background_busy() || count || !ee_ready()) return RES_BUSY;\r\n    return ee_write_byte(address,value);\r\n}\r\n#include \"services/settings.h\"\r\n#include \"settings_bytes.h\"\r\n#include <string.h>\r\n\r\nuint16_t set_crc16(const uint8_t *p, size_t n)\r\n{\r\n    return set_crc16_continue(0xFFFF,p,n);\r\n}\r\nuint16_t set_crc16_continue(uint16_t crc,const uint8_t *p,size_t n)\r\n{\r\n    size_t i; uint8_t bit;\r\n    if(p==NULL || n>SETTINGS_SLOT_SIZE) return 0;\r\n    for(i=0;i<n;++i) {\r\n        crc^=(uint16_t)((uint16_t)p[i]<<8);\r\n        for(bit=0;bit<8;++bit)\r\n            crc=(uint16_t)((crc&0x8000u)?((uint16_t)(crc<<1)^0x1021u):(uint16_t)(crc<<1));\r\n    }\r\n    return crc;\r\n}\r\nres_t set_validate_part(const settings_t *s,uint8_t first,uint8_t count,bool *fitted)\r\n{\r\n    uint8_t i,j,end=(uint8_t)(first+count);\r\n    if(s==NULL || fitted==NULL || first>s->channel_count || count>s->channel_count-first) return RES_ERR_RANGE;\r\n    if(!((s->board_type==8 && s->channel_count==8) ||\r\n         (s->board_type==24 && s->channel_count==24) ||\r\n         (s->board_type==40 && s->channel_count==43))) return RES_ERR_RANGE;\r\n    if(s->address<1 || s->address>247 || s->baud>1) return RES_ERR_RANGE;\r\n    for(i=0;i<4;++i) if(((s->pin_bcd>>(4u*i))&15u)>9u) return RES_ERR_RANGE;\r\n    for(i=first;i<end;++i) {\r\n        const chan_cfg_t *c=&s->ch[i]; int16_t max;\r\n        for(j=0;j<6;++j) if((uint8_t)c->name[j]<0x20 || (uint8_t)c->name[j]>0x7E) return RES_ERR_RANGE;\r\n        if(c->type_epoch>63 || (c->mode!=CH_MODE_TRIP && c->mode!=CH_MODE_ALARM_ONLY)) return RES_ERR_RANGE;\r\n        switch(c->type) {\r\n        case CH_TYPE_OFF:\r\n            if(c->mode!=CH_MODE_TRIP || c->alarm_dC!=0 || c->trip_dC!=0 ||\r\n               c->band_C!=2 || c->probe_limit_dC!=0) return RES_ERR_RANGE;\r\n            continue;\r\n        case CH_TYPE_K: max=13720; break;\r\n        case CH_TYPE_J: max=12000; break;\r\n        case CH_TYPE_PT100: max=4000; break;\r\n        default: return RES_ERR_RANGE;\r\n        }\r\n        if((i>=40)!=(c->type==CH_TYPE_PT100)) return RES_ERR_RANGE;\r\n        if(c->band_C<2 || c->band_C>50 || c->alarm_dC<0 || c->alarm_dC>=c->trip_dC ||\r\n           c->trip_dC>c->probe_limit_dC || c->probe_limit_dC>max) return RES_ERR_RANGE;\r\n        *fitted=true;\r\n    }\r\n    return RES_OK;\r\n}\r\nres_t set_validate(const settings_t *s)\r\n{\r\n    bool fitted=false;\r\n    return s!=NULL && set_validate_part(s,0,s->channel_count,&fitted)==RES_OK && fitted?RES_OK:RES_ERR_RANGE;\r\n}\r\nres_t set_pack_part(const settings_t *s,uint8_t *out,uint8_t first,uint8_t count)\r\n{\r\n    uint8_t i;\r\n    if(s==NULL || out==NULL || s->channel_count>MAX_CHANNELS || first>s->channel_count || count>s->channel_count-first) return RES_ERR_RANGE;\r\n    if(first==0) {\r\n        put16(out,0x5354); out[2]=1; out[3]=s->board_type; out[4]=s->channel_count;\r\n        put32(out+6,s->sequence); out[10]=s->address; out[11]=s->baud; put16(out+12,s->pin_bcd);\r\n    }\r\n    for(i=first;i<(uint8_t)(first+count);i++) {\r\n        const chan_cfg_t *c=&s->ch[i]; uint8_t *p=out+16u+16u*i;\r\n        p[0]=(uint8_t)c->type; p[1]=(uint8_t)c->mode; memcpy(p+2,c->name,6);\r\n        put16(p+8,(uint16_t)c->alarm_dC); put16(p+10,(uint16_t)c->trip_dC);\r\n        p[12]=c->band_C; p[13]=c->type_epoch; put16(p+14,(uint16_t)c->probe_limit_dC);\r\n    }\r\n    return RES_OK;\r\n}\r\nres_t set_pack(const settings_t *s, uint8_t out[SETTINGS_SLOT_SIZE])\r\n{\r\n    uint8_t i; uint16_t end;\r\n    if(out==NULL || set_validate(s)!=RES_OK) return RES_ERR_RANGE;\r\n    memset(out,0,SETTINGS_SLOT_SIZE);\r\n    put16(out,0x5354); out[2]=1; out[3]=s->board_type; out[4]=s->channel_count;\r\n    put32(out+6,s->sequence); out[10]=s->address; out[11]=s->baud; put16(out+12,s->pin_bcd);\r\n    for(i=0;i<s->channel_count;++i) {\r\n        const chan_cfg_t *c=&s->ch[i]; uint8_t *p=out+16u+16u*i;\r\n        p[0]=(uint8_t)c->type; p[1]=(uint8_t)c->mode; memcpy(p+2,c->name,6);\r\n        put16(p+8,(uint16_t)c->alarm_dC); put16(p+10,(uint16_t)c->trip_dC);\r\n        p[12]=c->band_C; p[13]=c->type_epoch; put16(p+14,(uint16_t)c->probe_limit_dC);\r\n    }\r\n    end=(uint16_t)(16u+16u*s->channel_count); put16(out+end,set_crc16(out,end));\r\n    return RES_OK;\r\n}\r\nres_t set_unpack(const uint8_t in[SETTINGS_SLOT_SIZE], uint8_t board_type,\r\n                 uint8_t channel_count, settings_t *s)\r\n{\r\n    uint8_t i; uint16_t end;\r\n    if(in==NULL || s==NULL || channel_count>MAX_CHANNELS) return RES_ERR_RANGE;\r\n    memset(s,0,sizeof(*s));\r\n    if(get16(in)!=0x5354 || in[2]!=1 || in[3]!=board_type || in[4]!=channel_count ||\r\n       in[5]!=0 || in[14]!=0 || in[15]!=0) return RES_ERR_RANGE;\r\n    end=(uint16_t)(16u+16u*channel_count);\r\n    if(get16(in+end)!=set_crc16(in,end)) return RES_ERR_CRC;\r\n    s->board_type=in[3]; s->channel_count=in[4]; s->sequence=get32(in+6);\r\n    s->address=in[10]; s->baud=in[11]; s->pin_bcd=get16(in+12);\r\n    for(i=0;i<channel_count;++i) {\r\n        chan_cfg_t *c=&s->ch[i]; const uint8_t *p=in+16u+16u*i;\r\n        c->type=(ch_type_t)p[0]; c->mode=(ch_mode_t)p[1]; memcpy(c->name,p+2,6);\r\n        c->alarm_dC=geti16(p+8); c->trip_dC=geti16(p+10); c->band_C=p[12];\r\n        c->type_epoch=p[13]; c->probe_limit_dC=geti16(p+14);\r\n    }\r\n    return set_validate(s);\r\n}\r\nint set_select(bool av, uint32_t a, bool bv, uint32_t b)\r\n{\r\n    uint32_t d=b-a;\r\n    if(!av) return bv?1:-1;\r\n    if(!bv) return 0;\r\n    return (d!=0 && d<UINT32_C(0x80000000))?1:0;\r\n}\r\nbool set_protection_changed(const settings_t *a, const settings_t *b)\r\n{\r\n    uint8_t i;\r\n    if(a==NULL || b==NULL || a->board_type!=b->board_type || a->channel_count!=b->channel_count ||\r\n       a->channel_count>MAX_CHANNELS) return true;\r\n    for(i=0;i<a->channel_count;++i) {\r\n        const chan_cfg_t *x=&a->ch[i], *y=&b->ch[i];\r\n        if(x->type!=y->type || x->mode!=y->mode || x->alarm_dC!=y->alarm_dC ||\r\n           x->trip_dC!=y->trip_dC || x->band_C!=y->band_C ||\r\n           x->probe_limit_dC!=y->probe_limit_dC || x->type_epoch!=y->type_epoch) return true;\r\n    }\r\n    return false;\r\n}\r\nres_t set_change_type(chan_cfg_t *c, ch_type_t type)\r\n{\r\n    if(c==NULL || (unsigned)type>CH_TYPE_PT100 || c->type_epoch>63) return RES_ERR_RANGE;\r\n    if(type==c->type) return RES_OK;\r\n    c->type=type; c->type_epoch=(uint8_t)((c->type_epoch+1u)&63u);\r\n    c->alarm_dC=0; c->trip_dC=0; c->probe_limit_dC=0;\r\n    if(type==CH_TYPE_OFF) { c->mode=CH_MODE_TRIP; c->band_C=2; }\r\n    return RES_OK;\r\n}\r\n","exit_code":0,"status":"completed"}}
