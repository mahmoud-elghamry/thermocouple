(version 1)

# Custom design rules for the 8-channel thermocouple protection board.
# Generated by apply_rules.py - edit that file, not this one.
#
# The board carries three separately referenced copper islands:
#   sensor island   fed by U12 (IA0505S) + U13, referenced to GND_SENS
#   control island  fed by U14 from +24 V,      referenced to GND_CTRL
#   RS-485 island   fed by the ADM2587E,        referenced to GND_RS485
# Signals cross only through U10/U11 (ISO7760/ISO7761) and U15.
#
# These are FUNCTIONAL isolation rules for an engineering prototype.
# They are not a safety-barrier qualification: no creepage/clearance
# analysis against IEC 61010 has been performed, and the shared sensor
# island still leaves the eight thermocouples common to each other.

(rule "isolation_sensor_to_control"
  (constraint clearance (min 3.0mm))
  (condition "((A.NetClass == 'SensorSignal' || A.NetClass == 'SensorPower') && (B.NetClass == 'Default' || B.NetClass == 'CtrlPower' || B.NetClass == 'Power24V')) || ((A.NetClass == 'Default' || A.NetClass == 'CtrlPower' || A.NetClass == 'Power24V') && (B.NetClass == 'SensorSignal' || B.NetClass == 'SensorPower'))"))

(rule "isolation_sensor_to_rs485"
  (constraint clearance (min 3.0mm))
  (condition "((A.NetClass == 'SensorSignal' || A.NetClass == 'SensorPower') && (B.NetClass == 'RS485')) || ((A.NetClass == 'RS485') && (B.NetClass == 'SensorSignal' || B.NetClass == 'SensorPower'))"))

(rule "isolation_control_to_rs485"
  (constraint clearance (min 3.0mm))
  (condition "((A.NetClass == 'Default' || A.NetClass == 'CtrlPower' || A.NetClass == 'Power24V') && (B.NetClass == 'RS485')) || ((A.NetClass == 'RS485') && (B.NetClass == 'Default' || B.NetClass == 'CtrlPower' || B.NetClass == 'Power24V'))"))

# Dry contact on J3.  Marked LOW-VOLTAGE LOAD ONLY; this margin is
# functional, not a mains creepage qualification.
(rule "relay_contact_to_everything_else"
  (constraint clearance (min 2.0mm))
  (condition "((A.NetClass == 'RelayContact') && (B.NetClass == 'Default' || B.NetClass == 'SensorSignal' || B.NetClass == 'SensorPower' || B.NetClass == 'CtrlPower' || B.NetClass == 'Power24V' || B.NetClass == 'RS485' || B.NetClass == 'Chassis' || B.NetClass == 'NoConnect')) || ((A.NetClass == 'Default' || A.NetClass == 'SensorSignal' || A.NetClass == 'SensorPower' || A.NetClass == 'CtrlPower' || A.NetClass == 'Power24V' || A.NetClass == 'RS485' || A.NetClass == 'Chassis' || A.NetClass == 'NoConnect') && (B.NetClass == 'RelayContact'))"))

# Cable-shield / PE ring: isolated from all three signal grounds so a
# shield current cannot become a measurement ground loop.
(rule "chassis_to_everything_else"
  (constraint clearance (min 1.5mm))
  (condition "((A.NetClass == 'Chassis') && (B.NetClass == 'Default' || B.NetClass == 'SensorSignal' || B.NetClass == 'SensorPower' || B.NetClass == 'CtrlPower' || B.NetClass == 'Power24V' || B.NetClass == 'RelayContact' || B.NetClass == 'RS485' || B.NetClass == 'NoConnect')) || ((A.NetClass == 'Default' || A.NetClass == 'SensorSignal' || A.NetClass == 'SensorPower' || A.NetClass == 'CtrlPower' || A.NetClass == 'Power24V' || A.NetClass == 'RelayContact' || A.NetClass == 'RS485' || A.NetClass == 'NoConnect') && (B.NetClass == 'Chassis'))"))

# Thermocouple inputs measure microvolts; keep the annular ring healthy
# on the few vias they are allowed to use.
(rule "sensor_signal_annular_ring"
  (constraint annular_width (min 0.15mm))
  (condition "A.NetClass == 'SensorSignal'"))
