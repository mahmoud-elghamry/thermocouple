oot/include`\" /I`\"$root/test/fakes`\" $quoted /Fe:`\"$exe`\" /Fo:`\"$out/`\" /Fd:`\"$out/hardware.pdb`\"\"\r\n    Run $env:ComSpec @('/d','/s','/c',$cmd)\r\n    Run $env:ComSpec @('/d','/s','/c',\"set `\"PATH=$installer;%PATH%`\" && call `\"$dev`\" -arch=x64 -no_logo && `\"$exe`\"\")\r\n    $timerExe=Join-Path $out 'test_timer.exe'\r\n    $cmd=\"set `\"PATH=$installer;%PATH%`\" && call `\"$dev`\" -arch=x64 -no_logo && cl /nologo /std:c11 /W4 /WX /O2 /I`\"$root/test/stubs`\" /I`\"$root/include`\" `\"$root/src/mcal/timer.c`\" `\"$root/test/integration/test_timer.c`\" /Fe:`\"$timerExe`\" /Fo:`\"$out/`\"\"\r\n    Run $env:ComSpec @('/d','/s','/c',$cmd)\r\n    Run $timerExe @()\r\n    $prepExe=Join-Path $out 'test_prepare.exe'\r\n    $cmd=\"set `\"PATH=$installer;%PATH%`\" && call `\"$dev`\" -arch=x64 -no_logo && cl /nologo /std:c11 /W4 /WX /O2 /I`\"$root/include`\" `\"$root/src/services/settings.c`\" `\"$root/src/services/settings_cal.c`\" `\"$root/src/services/settings_store.c`\" `\"$root/test/integration/test_prepare.c`\" /Fe:`\"$prepExe`\" /Fo:`\"$out/`\"\"\r\n    Run $env:ComSpec @('/d','/s','/c',$cmd)\r\n    Run $prepExe @()\r\n}\r\nif(-not $HostOnly) {\r\n    $bin='C:/Program Files (x86)/Labcenter Electronics/Proteus 8 Professional/Tools/ARDUINO/hardware/tools/avr/bin'\r\n    $gcc=Join-Path $bin 'avr-gcc.exe'\r\n    $stackHeader=Get-Content (Join-Path $root 'include/app/stack_budget.h') -Raw\r\n    $stackBytes=[int]([regex]::Match($stackHeader,'#define APP_STACK_BYTES (\\d+)u').Groups[1].Value)\r\n    if($stackBytes -lt 1024) { throw 'Stack reservation missing/too small' }\r\n    # The existing pure commit owns a settings + calibration working copy.\r\n    # Keep the shell canary below that frame plus caller/interrupt margin.\r\n    $stackObj=Join-Path $out 'settings_stack.o'\r\n    Run $gcc @('-std=c11','-Os','-Wall','-Wextra','-Werror','-mmcu=atmega1284p',\"-I$root/include\",'-fstack-usage','-c',(Join-Path $root 'src/services/settings_store.c'),'-o',$stackObj)\r\n    $frames=Get-Content (Join-Path $out 'settings_stack.su') | ForEach-Object {\r\n        if($_ -match '\\t(\\d+)\\t') { [int]$Matches[1] }\r\n    }\r\n    $maxFrame=($frames | Measure-Object -Maximum).Maximum\r\n    if(-not $maxFrame -or $maxFrame+384 -gt $stackBytes) { throw \"Commit stack frame $maxFrame + 384 margin exceeds $stackBytes\" }\r\n    Write-Host \"AVR commit frame: $maxFrame bytes; caller/interrupt margin: 384; stack reservation: $stackBytes\"\r\n    $elf=Join-Path $out 'thermo24_f1.elf'\r\n    $flags=@('-std=c11','-Os','-Wall','-Wextra','-Werror','-mmcu=atmega1284p','-DF_CPU=8000000UL',\"-I$root/include\",'-ffunction-sections','-fdata-sections','-Wl,--gc-sections,--section-start=.image_crc=0x1FFFE,--undefined=image_crc')\r\n    Run $gcc ($flags+@(Sources 'hardware_avr')+@('-o',$elf))\r\n    $objcopy=Join-Path $bin 'avr-objcopy.exe'\r\n    $raw=Join-Path $out 'image.bin'\r\n    Run $objcopy @('-O','binary','-j','.text','-j','.data',$elf,$raw)\r\n    $endLine=& (Join-Path $bin 'avr-nm.exe') '--defined-only' $elf | Select-String ' __data_load_end$'\r\n    if(-not $endLine) { throw '__data_load_end missing' }\r\n    $end=[Convert]::ToInt32(($endLine.ToString() -split '\\s+')[0],16)\r\n    $image=[IO.File]::ReadAllBytes($raw)\r\n    if($image.Length -ne $end) { throw 'Flash CRC image extent mismatch' }\r\n    [uint32]$crc=65535\r\n    foreach($byte in $image) {\r\n        $crc=$crc -bxor ([uint32]$byte -shl 8)\r\n        for($bit=0;$bit -lt 8;$bit++) {\r\n            if($crc -band 32768) { $crc=($crc -shl 1) -bxor 4129 } else { $crc=$crc -shl 1 }\r\n            $crc=$crc -band 65535\r\n        }\r\n    }\r\n    $crcFile=Join-Path $out 'image_crc.bin'\r\n    [IO.File]::WriteAllBytes($crcFile,[byte[]]@(($crc -band 255),($crc -shr 8)))\r\n    Run $objcopy @('--update-section',\".image_crc=$crcFile\",$elf)\r\n    $verified=Join-Path $out 'verified_image.bin'\r\n    Run $objcopy @('-O','binary','--gap-fill=0xFF','-j','.text','-j','.data','-j','.image_crc',$elf,$verified)\r\n    $check=[IO.File]::ReadAllBytes($verified)\r\n    if($check.Length -ne 131072 -or $check[131070] -ne ($crc -band 255) -or $check[131071] -ne ($crc -shr 8)) {\r\n        throw 'Stored flash CRC read-back failed'\r\n    }\r\n    for($i=0;$i -lt $end;$i++) { if($check[$i] -ne $image[$i]) { throw 'Flash changed while inserting CRC' } }\r\n    Write-Host ('Stored flash CRC16: {0:X4}, bytes: {1}' -f $crc,$end)\r\n    $sections=& (Join-Path $bin 'avr-size.exe') '-A' $elf\r\n    [int]$ram=0\r\n    foreach($row in $sections) { if($row -match '^\\.(data|bss|noinit)\\s+(\\d+)') { $ram+=[int]$Matches[2] } }\r\n    if($ram+$stackBytes -gt 12288) { throw \"RAM budget exceeded: $ram + $stackBytes stack\" }\r\n    if($end+2 -gt 65536) { throw \"Flash budget exceeded: $end + 2 CRC\" }\r\n    Write-Host \"RAM with $stackBytes-byte stack allowance: $($ram+$stackBytes)/12288; flash CRC storage: 2 bytes\"\r\n    Run (Join-Path $bin 'avr-objcopy.exe') @('-O','ihex','-R','.eeprom',$elf,(Join-Path $out 'thermo24_f1.hex'))\r\n    Run (Join-Path $bin 'avr-size.exe') @('-C','--mcu=atmega1284p',$elf)\r\n}\r\nStop-Transcript | Out-Null\r\n/* Exclude register-model CPU from AVR timing. The measured application keeps\r\n * every real driver/service instruction; MCAL costs are bounded separately. */\r\n#define gpio_init base_gpio_init\r\n#define gpio_write base_gpio_write\r\n#define gpio_read base_gpio_read\r\n#define gpio_mask base_gpio_mask\r\n#define delay_us base_delay_us\r\n#define spi_init base_spi_init\r\n#define spi_enable base_spi_enable\r\n#define spi_xfer base_spi_xfer\r\n#define spi_soft_xfer base_spi_soft_xfer\r\n#define timer_init base_timer_init\r\n#define tick_ms base_tick_ms\r\n#define timer_run_start base_timer_run_start\r\n#define timer_run_start_at base_timer_run_start_at\r\n#define timer_run_stop base_timer_run_stop\r\n#define timer_run_remaining base_timer_run_remaining\r\n#define timer_run_active base_timer_run_active\r\n#define timer_run_expired base_timer_run_expired\r\n#define timer_run_ack_expiry base_timer_run_ack_expiry\r\n#define timer_run_static_high base_timer_run_static_high\r\n#define wdt_feed base_wdt_feed\r\n#define reset_cause base_reset_cause\r\n#define fuses_read base_fuses_read\r\n#define fuses_ok base_fuses_ok\r\n#define flow_check base_flow_check\r\n#define ee_read base_ee_read\r\n#define ee_ready base_ee_ready\r\n#define ee_write_byte base_ee_write_byte\r\n#define uart_init base_uart_init\r\n#include \"app/ack_input.h\"\r\n#include \"drivers/keys.h\"\r\n#include \"mcal/timer.h\"\r\nvoid ack_input_init(void) { keys_rearm(); }\r\nvoid ack_input_cancel(void) { ack_input_init(); }\r\nvoid ack_input_step(prot_in_t *in) {\r\n    uint8_t i; key_event_t e;\r\n    in->ack_key_released=(keys_held()&8u)==0;\r\n    in->ack=false; in->ack_held_ms=in->ack_age_ms=0;\r\n    for(i=0;i<7;i++) {\r\n        if(!keys_get_event(&e)) break;\r\n        if(e.key==KEY_ACK) {\r\n            uint32_t held=e.event_ms-e.pressed_ms,age=tick_ms()-e.event_ms;\r\n            in->ack=true; in->ack_held_ms=(uint16_t)(held>65535u?65535u:held);\r\n            in->ack_age_ms=(uint16_t)(age>65535u?65535u:age);\r\n        }\r\n    }\r\n}\r\n---\r\nname: personal-workstyle\r\ndescription: Apply and evolve this user's cross-domain collaboration protocol. Use for any substantive task with this user, especially multi-part requests, planning and execution, tool or agent setup, cost or scale decisions, and moments where the user corrects an assumption or clarifies how work should be handled.\r\n---\r\n\r\n# Personal Workstyle\r\n\r\nUse this skill as a collaboration layer alongside the task-specific skill. It preserves durable operating principles across chats without turning temporary choices into permanent rules.\r\n\r\n## Start Every Substantive Task\r\n\r\n1. Read [references/profile.md](references/profile.md).\r\n2. Build a private request ledger covering every question, correction, requested action, and unresolved branch across the user's recent messages. Do not silently focus only on the last sentence.\r\n3. Identify the real outcome behind the immediate request. Distinguish a one-off answer from a request for a reusable system, scalable workflow, or cross-agent capability.\r\n4. Apply the relevant profile principles while following the user's current request and any task-specific skill. The current explicit request always wins.\r\n\r\n## Working Method\r\n\r\n- Distinguish clearly between installed, discovered, callable, tested, reliable, and production-ready.\r\n- Verify consequential claims against the real environment. Do not infer that a desktop app implies a usable CLI, that copying a skill implies discovery, or that a technically successful connection is usable in the intended interface.\r\n- Consider scale, local hardware, usage limits, monetary cost, maintenance, portability, and interface clutter when they materially affect the solution.\r\n- Prefer deterministic local processing for high-volume repeatable work and model judgment for ambiguity, review, and exceptions.\r\n- Keep experimental providers and integrations isolated until they are verified. Avoid polluting a stable default configuration.\r\n- Preserve rollback, logs, and recoverability for bulk changes; remove temporary artifacts after verification when they no longer provide reuse or audit value.\r\n- When delegation is requested or permitted, keep the strongest suitable agent as planner/reviewer and use cheaper, free, or specialized workers for bounded execution. Verify the worker's actual output.\r\n- Once the user has made an informed risk decision, execute within that decision instead of repeating the same warning. Reopen the issue only if the risk or scope materially changes.\r\n- Report provenance and maturity honestly. Separate original upstream work, local adaptation, inference, live testing, and recommendation.\r\n\r\n## Evolve the Profile\r\n\r\nAt the end of every substantive use, check whether the interaction produced a durable new operational insight. A profile update is justified when at least one is true:\r\n\r\n- The user explicitly asks to remember a general working principle.\r\n- The user corrects a method, assumption, or interpretation in a way that generalizes beyond the current task.\r\n- The same preference or decision pattern appears across at least two different contexts.\r\n- A verified environment fact changes how future work should be routed.\r\n\r\nIf justified, update `references/profile.md` with a small merge and append one concise entry to `references/history.md`. Use `apply_patch`; routine learning does not require loading `skill-creator` again.\r\n\r\nDo not update the profile for casual wording, a one-off output preference, temporary project state, speculative personality analysis, or a choice forced by current constraints. If no durable insight emerged, make no file change.\r\n\r\n### Update Boundaries\r\n\r\n- The user's standing request authorizes local maintenance only inside this skill folder. It does not authorize unrelated file, account, service, or configuration changes.\r\n- Never store credentials, API keys, tokens, private document contents, personal identifiers not needed for collaboration, or inferred sensitive traits.\r\n- Record operational preferences and verified context, not a psychological profile.\r\n- Latest explicit corrections replace older inferences. Preserve useful nuance instead of accumulating contradictory bullets.\r\n- Keep `profile.md` concise and deduplicated. Keep at most the 30 most useful entries in `history.md`.\r\n- Mention a material profile update briefly in the final response. Do not let maintenance delay the user's actual task.\r\n- If writing is unavailable, complete the task and state that the profile could not be updated.\r\n\r\n## Relationship to Other Skills\r\n\r\nThis skill shapes collaboration and routing; it does not replace domain skills. A media, document, coding, browser, delegation, or other specialized skill owns its technical workflow. Resolve conflicts in this order: system and developer instructions, the user's current request, the task-specific skill, then this evolving profile.\r\n","exit_code":0,"status":"completed"}}
