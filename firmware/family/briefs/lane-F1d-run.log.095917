t();\r\n        if(!(cmd&0x100u)) return RES_OK;\r\n        bytes[0]=(uint8_t)(cmd>>8); bytes[1]=(uint8_t)cmd; bytes[2]=(uint8_t)(*v>>8); bytes[3]=(uint8_t)*v;\r\n        if(cj_crc16(bytes,4)==crc) return RES_OK;\r\n    }\r\n    return RES_ERR_CRC;\r\n}\r\nres_t cj_init(uint8_t j) {\r\n    uint16_t v=4; res_t r=frame(j,0x0003,&v); /* OPEN-Q12: configuration write without CRC */\r\n    if(r==RES_OK) r=frame(j,0x4503,&v);\r\n    if(r!=RES_OK) return r; if(v!=4) return RES_ERR_READBACK;\r\n    v=signature(j); r=frame(j,0x4405,&v);\r\n    if(r==RES_OK) r=frame(j,0x4505,&v);\r\n    if(r!=RES_OK) return r;\r\n    age[j]=0; return v==signature(j)?RES_OK:RES_ERR_READBACK;\r\n}\r\nres_t cj_read(uint8_t j,int32_t *t) {\r\n    uint8_t i; res_t r=RES_BUSY;\r\n    read_step=0;\r\n    for(i=0;i<5 && r==RES_BUSY;i++) r=cj_read_step(j,t);\r\n    return r;\r\n}\r\nres_t cj_read_step(uint8_t j,int32_t *t) {\r\n    static const uint8_t reg[5]={2,0,12,3,5}; res_t r;\r\n    if(j>=board()->cj_count) return RES_ERR_RANGE;\r\n    if(!read_step || reading!=j) { reading=j; read_step=0; last_id[j]=0; }\r\n    r=frame(j,(uint16_t)(0x4500u|reg[read_step]),&sample[read_step]);\r\n    if(r!=RES_OK) { read_step=0; return r; }\r\n    if(read_step==0) {\r\n        if(sample[0]&0x80u) return RES_ERR_CRC;\r\n        if(sample[0]&1u) age[j]=0; else if(age[j]<255) ++age[j];\r\n    }\r\n    if(read_step==2) last_id[j]=sample[2];\r\n    if(++read_step<5) return RES_BUSY;\r\n    read_step=0;\r\n    if(sample[2]!=0x2126) return RES_ERR_ID;\r\n    if(sample[3]!=4 || sample[4]!=signature(j)) return RES_ERR_READBACK;\r\n    { int32_t scaled=(int32_t)(int16_t)sample[1]*125;\r\n      *t=scaled>=0?scaled/16:-((-scaled+15)/16); /* exact arithmetic >>4, portable for negatives */\r\n    }\r\n    if(age[j]>2 || *t < -40000 || *t>125000 || (sample[1]&3)) return RES_ERR_RANGE;\r\n    return RES_OK;\r\n}\r\n    CHECK(ad_fault(0)==FC_B01_ADC_ID);\r\n}\r\nstatic void cj_budget(void) {\r\n    unsigned i; uint32_t bytes,start;\r\n    setup(false); start=scan_last()->scan_no;\r\n    for(i=0;i<1600;i++) {\r\n        bytes=fake_soft_bytes; f0_task();\r\n        CHECK(fake_soft_bytes-bytes<=12); /* One frame, including one CRC retry. */\r\n        fake_advance(1);\r\n    }\r\n    CHECK(scan_last()->scan_no>=start+2 && scan_last()->scan_validated);\r\n}\r\nstatic void blank(void) {\r\n    fake_reset(); f0_init(); loop(3000); CHECK(f0_mode()==CONFIG_LOCK && !timer_run_active());\r\n    fake_reset(); fake_pin(board()->keys[2],false); f0_init(); loop(3000); CHECK(f0_mode()==SERVICE);\r\n    setup(false); fake_eeprom[0x640]=0; f0_init(); loop(3000);\r\n    CHECK(f0_mode()==CONFIG_LOCK && !timer_run_active());\r\n}\r\nstatic void validation_budget(void) {\r\n    unsigned i,completed=0; uint32_t last; settings_t cfg; calibration_t cal; uint8_t bytes[SETTINGS_SLOT_SIZE];\r\n    setup(false); cfg=*app_settings(); memset(&cal,0,sizeof cal); cal.bank_count=3;\r\n    for(i=0;i<MAX_CHANNELS;i++) cal.baseline_nV[i]=CAL_MISSING;\r\n    for(i=0;i<24;i++) { cfg.ch[i]=cfg.ch[0]; cal.baseline_nV[i]=3200000; cal.tag[i]=1; }\r\n    CHECK(set_pack(&cfg,bytes)==RES_OK); memcpy(fake_eeprom+0x40,bytes,sizeof bytes);\r\n    CHECK(cal_pack(&cal,bytes)==RES_OK); memcpy(fake_eeprom+0x640,bytes,CAL_SLOT_SIZE);\r\n    f0_init(); loop(3000); last=scan_last()->scan_no;\r\n    for(i=0;i<1600;i++) {\r\n        (void)settings_validation_count(); f0_task();\r\n        CHECK(settings_validation_count()==1);\r\n        if(scan_last()->scan_no!=last) { ++completed; last=scan_last()->scan_no; }\r\n        fake_advance(1);\r\n    }\r\n    CHECK(completed>=2);\r\n}\r\nstatic void event_cursor(void) {\r\n    settings_t cfg; calibration_t cal; events_t expected; event_t e; unsigned i;\r\n    setup(false); cfg=*app_settings(); memset(&cal,0,sizeof cal); cal.bank_count=3;\r\n    fake_reset(); memset(&e,0,sizeof e); e.type=EV_ACK;\r\n    for(i=0;i<EVENT_SLOTS;i++) {\r\n        e.sequence=(uint16_t)(0xFFF0u+i); CHECK(ev_pack(&e,expected.slot[i])==RES_OK);\r\n    }\r\n    expected.slot[31][15]^=1; /* Torn newest slot; sequence wraps in the ring. */\r\n    memcpy(fake_eeprom+0x840,&expected,sizeof expected);\r\n    ee_owner_init(&cfg,&cal,0,0,true);\r\n    for(i=0;i<2;i++) {\r\n        e.type=EV_ALARM; e.code=FC_C11_OVER_ALARM; e.power_cycles=1;\r\n        CHECK(ee_owner_log(&e)); CHECK(ev_log(&expected,&e)>=0);\r\n    }\r\n    for(i=0;i<300 && !ee_owner_events_drained();i++) { ee_owner_step(); fake_advance(4); }\r\n    CHECK(i<300 && memcmp(fake_eeprom+0x840,&expected,sizeof expected)==0);\r\n}\r\nvoid test_review(void) {\r\n    timestamp(); cj_budget(); expiry(); service_abort(); blank(); validation_budget(); event_cursor(); adc_verifier();\r\n    printf(\"Astra review: %u checks PASS\\n\",checks);\r\n}\r\n#ifndef FAMILY_EE_OWNER_H\r\n#define FAMILY_EE_OWNER_H\r\n#include \"services/settings.h\"\r\n#include \"services/events.h\"\r\n#include \"services/fault.h\"\r\n/* Single EEPROM writer. Settings use the app's immutable command mailbox until\r\n * preparation completes; calibration is copied here. Submit through app's\r\n * copy/edit/validate mailbox; do not mutate it while this owner is busy.\r\n * Init is boot/service-only, with no operation in flight. */\r\nvoid ee_owner_init(settings_t *settings, calibration_t *cal, uint8_t settings_slot,\r\n                   uint8_t cal_slot, bool settings_valid);\r\nuint8_t *ee_owner_boot_image(void); /* boot-only scratch, before init */\r\nres_t ee_owner_settings(const settings_t *candidate);\r\nres_t ee_owner_calibration(const calibration_t *candidate);\r\nvoid ee_owner_step(void); /* <= one nonblocking byte operation */\r\nbool ee_owner_busy(void);\r\nstore_phase_t ee_owner_phase(void);\r\nbool ee_owner_publish_pending(void);\r\nbool ee_owner_protection_change(void);\r\nbool ee_owner_take_begin(void);\r\n/* 1 settings, 2 calibration, 0 none; failed transaction never publishes RAM. */\r\nuint8_t ee_owner_take_done(void);\r\nfault_code_t ee_owner_fault(void);\r\nbool ee_owner_cal_saved(void);\r\nbool ee_owner_settings_valid(void);\r\n/* Full queue drops the NEW entry; loss is G13, never an internal trip. */\r\nbool ee_owner_log(const event_t *event);\r\nuint32_t ee_owner_events_lost(void); /* saturating count, since owner boot init */\r\nbool ee_owner_events_drained(void); /* includes the final byte becoming ready */\r\nbool ee_owner_info_fault(void); /* G13 sources: save failure, I/O, event loss */\r\nvoid ee_owner_ack_events(void); /* call ONLY for an accepted ACK; drain required */\r\nvoid ee_owner_validated_scan(fault_code_t reset_code, uint32_t uptime_s);\r\nuint32_t ee_owner_cycles(void);\r\n/* Scratch writes also serialize with transactions/events; service-only. */\r\nres_t ee_owner_scratch(uint16_t address, uint8_t value);\r\n#endif\r\n                memset(&calibration,0,sizeof calibration); calibration.bank_count=board()->banks;\r\n                for(i=0;i<board()->banks;i++) calibration.ref_ppm[i]=CAL_MISSING;\r\n                for(i=0;i<MAX_CHANNELS;i++) calibration.baseline_nV[i]=CAL_MISSING;\r\n            }\r\n            cal_valid=selected>=0 && set_valid && cal_complete(&calibration,&active);\r\n            if(!cal_valid) (void)fault_raise(&faults,FC_G10_CALIBRATION,0);\r\n            boot=BEGIN_ACQ;\r\n        } break;\r\n    case RELOAD_CAL_A:\r\n        load_bytes(0x640,CAL_SLOT_SIZE);\r\n        if(load_pos==CAL_SLOT_SIZE) {\r\n            cal_slot=0; cal_valid=cal_unpack(bytes,board()->banks,&calibration)==RES_OK && set_valid && cal_complete(&calibration,&active);\r\n            if(!cal_valid) (void)fault_raise(&faults,FC_G10_CALIBRATION,0); boot=BEGIN_ACQ;\r\n        } break;\r\n    case BEGIN_ACQ:\r\n        mode=service_entry?SERVICE:((set_valid && cal_valid)?START_LATCHED:CONFIG_LOCK);\r\n        scan_init(service_entry?NULL:&active,&calibration,&faults);\r\n        if(service_entry) svc_init(&active,&calibration,set_valid,a_valid,b_valid,cal_slot,flash_valid);\r\n        else { char frame[80]; memset(frame,' ',80);\r\n            memcpy(frame,mode==CONFIG_LOCK?\"LOCKED: CALIBRATE  \":\"START: ACK REQUIRED\",19); lcd_frame(frame); }\r\n        ee_owner_init(&active,&calibration,settings_slot,cal_slot,set_valid);\r\n        app_init(&active,&calibration,&faults,set_valid,service_entry);\r\n        keys_rearm(); boot=LOOP; break;\r\n    default: relays_safe(); boot=BEGIN_ACQ; break;\r\n    }\r\n}\r\nvoid f0_task(void) {\r\n    uint32_t start=tick_ms(),progress; uint8_t seen=0,i;\r\n    if(boot!=LOOP) { boot_step(); progress=boot_progress; }\r\n    else { scan_task(); progress=scan_progress_ms(); }\r\n    seen|=1;\r\n    keys_task(); seen|=2;\r\n    if(boot==LOOP && flash_valid) {\r\n        seen|=(uint8_t)(app_step(tick_ms()-progress<=100u)<<2);\r\n        mode=(uint8_t)app_protection()->mode;\r\n        if(mode==SERVICE) { svc_task(); seen|=8; }\r\n    } else { relays_safe(); seen|=12; }\r\n    lcd_task(); seen|=16; rs485_task(); seen|=32;\r\n    /* SERVICE steps the same EEPROM owner itself (also used by standalone\r\n     * service driver tests). Normal mode executes exactly one owner step here. */\r\n    if(boot==LOOP && mode!=SERVICE && flash_valid) ee_owner_step();\r\n    seen|=64;\r\n    for(i=0;i<16;i++) if(stack_guard[i]!=0xA5) {\r\n        relays_safe(); (void)fault_raise(&faults,FC_G04_INTERNAL,0); return;\r\n    }\r\n    seen|=128;\r\n    if(tick_ms()-start>8) { relays_safe(); (void)fault_raise(&faults,FC_G04_INTERNAL,0); return; }\r\n    if(mode==SERVICE) svc_loop_time((uint16_t)(tick_ms()-start));\r\n    if(boot==LOOP) app_loop_time((uint16_t)(tick_ms()-start));\r\n    (void)flow_check(seen,255,progress);\r\n}\r\nuint8_t f0_mode(void) { return mode; }\r\n#ifndef FAMILY_TEST\r\nint main(void) { f0_init(); for(;;) f0_task(); }\r\n#endif\r\n","exit_code":0,"status":"completed"}}
