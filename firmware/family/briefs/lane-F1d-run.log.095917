{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content firmware/family/test/integration/test_prepare.c; Get-Content firmware/family/src/services/settings_cal.c; Get-Content firmware/family/include/services/settings.h'","aggregated_output":"#include \"services/settings.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\nstatic unsigned checks;\r\n#define CHECK(x) do { ++checks; if(!(x)) { printf(\"prepare FAIL %d: %s\\n\",__LINE__,#x); exit(1); } } while(0)\r\nstatic settings_t cfg,next;\r\nstatic calibration_t cal;\r\nstatic set_store_t reference,st;\r\nstatic void prepare(void) {\r\n    ee_op_t op; unsigned n;\r\n    for(n=0;n<200 && st.phase==STORE_PREPARE;n++) {\r\n        set_store_step(&st,true,true,0,&op); CHECK(op.kind==EE_NONE);\r\n    }\r\n    CHECK(n>1 && n<200 && st.phase==STORE_INVALIDATE);\r\n    CHECK(memcmp(st.image,reference.image,SETTINGS_SLOT_SIZE)==0);\r\n    if(st.settings_after_cal) CHECK(memcmp(st.wrap_cal_image,reference.wrap_cal_image,CAL_SLOT_SIZE)==0);\r\n    CHECK(st.protection_change==reference.protection_change && st.settings_after_cal==reference.settings_after_cal);\r\n    CHECK(st.base==reference.base && st.length==reference.length);\r\n}\r\nint main(void) {\r\n    unsigned i; ee_op_t op;\r\n    memset(&cfg,0,sizeof cfg); memset(&cal,0,sizeof cal);\r\n    cfg.board_type=cfg.channel_count=24; cfg.address=1; cfg.sequence=7; cal.bank_count=3;\r\n    for(i=0;i<MAX_CHANNELS;i++) { memset(cfg.ch[i].name,' ',6); cfg.ch[i].band_C=2; cal.baseline_nV[i]=CAL_MISSING; }\r\n    cfg.ch[0].type=CH_TYPE_K; cfg.ch[0].alarm_dC=800; cfg.ch[0].trip_dC=1000; cfg.ch[0].probe_limit_dC=12000;\r\n    cal.baseline_nV[0]=3200000; cal.tag[0]=1;\r\n    for(i=0;i<3;i++) {\r\n        next=cfg;\r\n        if(i==0) next.ch[0].name[0]='X';\r\n        if(i==1) next.ch[0].trip_dC=1100;\r\n        if(i==2) { cfg.ch[0].type_epoch=63; cal.tag[0]=253; next=cfg; next.ch[0].type=CH_TYPE_J; next.ch[0].type_epoch=0; }\r\n        set_store_init(&reference); set_store_init(&st);\r\n        CHECK(set_commit_with_cal(&reference,&next,&cfg,0,&cal,0)==RES_OK);\r\n        CHECK(set_prepare_with_cal(&st,&next,&cfg,0,&cal,0)==RES_OK && st.phase==STORE_PREPARE);\r\n        CHECK(st.protection_change==(i!=0)); prepare();\r\n    }\r\n    set_store_init(&reference); set_store_init(&st);\r\n    CHECK(cal_commit(&reference,&cal,cal.sequence,0)==RES_OK);\r\n    CHECK(cal_prepare(&st,&cal,cal.sequence,0)==RES_OK); prepare();\r\n    set_store_init(&st); next=cfg; next.ch[0].name[0]=0;\r\n    CHECK(set_prepare_with_cal(&st,&next,&cfg,0,&cal,0)==RES_OK);\r\n    for(i=0;i<200 && st.phase==STORE_PREPARE;i++) {\r\n        set_store_step(&st,true,true,0,&op); CHECK(op.kind==EE_NONE);\r\n    }\r\n    CHECK(st.phase==STORE_FAILED); printf(\"Store preparation: %u checks PASS\\n\",checks); return 0;\r\n}\r\n#include \"services/settings.h\"\r\n#include \"settings_bytes.h\"\r\n#include <string.h>\r\nres_t cal_validate(const calibration_t *c)\r\n{\r\n    uint8_t i;\r\n    if(c==NULL || c->bank_count<1 || c->bank_count>MAX_BANKS) return RES_ERR_RANGE;\r\n    for(i=0;i<MAX_BANKS;++i) {\r\n        if(i>=c->bank_count) { if(c->ref_ppm[i]!=0) return RES_ERR_RANGE; }\r\n        else if(c->ref_ppm[i]!=CAL_MISSING && (c->ref_ppm[i]<-10000 || c->ref_ppm[i]>10000)) return RES_ERR_RANGE;\r\n    }\r\n    for(i=0;i<MAX_CHANNELS;++i) {\r\n        if(c->baseline_nV[i]==CAL_MISSING) { if(c->tag[i]!=0) return RES_ERR_RANGE; }\r\n        else if(c->baseline_nV[i]<1500000 || c->baseline_nV[i]>10000000 ||\r\n                ((c->tag[i]&3u)!=1u && (c->tag[i]&3u)!=2u)) return RES_ERR_RANGE;\r\n    }\r\n    return RES_OK;\r\n}\r\nres_t cal_pack(const calibration_t *c, uint8_t out[CAL_SLOT_SIZE])\r\n{\r\n    uint8_t i;\r\n    if(out==NULL || cal_validate(c)!=RES_OK) return RES_ERR_RANGE;\r\n    memset(out,0,CAL_SLOT_SIZE); put16(out,0x434C); out[2]=1; out[3]=c->bank_count;\r\n    put32(out+4,c->sequence);\r\n    for(i=0;i<MAX_BANKS;++i) put32(out+8u+4u*i,(uint32_t)c->ref_ppm[i]);\r\n    for(i=0;i<MAX_CHANNELS;++i) {\r\n        put32(out+32u+4u*i,(uint32_t)c->baseline_nV[i]); out[204u+i]=c->tag[i];\r\n    }\r\n    put16(out+247,set_crc16(out,247)); return RES_OK;\r\n}\r\nres_t cal_pack_part(const calibration_t *c,uint8_t *out,uint8_t first,uint8_t count)\r\n{\r\n    uint8_t i;\r\n    if(c==NULL || out==NULL || first>MAX_BANKS+MAX_CHANNELS || count>MAX_BANKS+MAX_CHANNELS-first) return RES_ERR_RANGE;\r\n    if(first==0) { put16(out,0x434C); out[2]=1; out[3]=c->bank_count; put32(out+4,c->sequence); }\r\n    for(i=first;i<(uint8_t)(first+count);i++) {\r\n        if(i<MAX_BANKS) put32(out+8u+4u*i,(uint32_t)c->ref_ppm[i]);\r\n        else { uint8_t ch=(uint8_t)(i-MAX_BANKS);\r\n            put32(out+32u+4u*ch,(uint32_t)c->baseline_nV[ch]); out[204u+ch]=c->tag[ch]; }\r\n    }\r\n    return RES_OK;\r\n}\r\nres_t cal_unpack(const uint8_t in[CAL_SLOT_SIZE], uint8_t banks, calibration_t *c)\r\n{\r\n    uint8_t i;\r\n    if(in==NULL || c==NULL) return RES_ERR_RANGE;\r\n    memset(c,0,sizeof(*c));\r\n    if(get16(in)!=0x434C || in[2]!=1 || in[3]!=banks) return RES_ERR_RANGE;\r\n    if(get16(in+247)!=set_crc16(in,247)) return RES_ERR_CRC;\r\n    c->bank_count=banks; c->sequence=get32(in+4);\r\n    for(i=0;i<MAX_BANKS;++i) c->ref_ppm[i]=geti32(in+8u+4u*i);\r\n    for(i=0;i<MAX_CHANNELS;++i) { c->baseline_nV[i]=geti32(in+32u+4u*i); c->tag[i]=in[204u+i]; }\r\n    return cal_validate(c);\r\n}\r\nbool cal_complete(const calibration_t *c, const settings_t *s)\r\n{\r\n    uint8_t i, banks;\r\n    if(cal_validate(c)!=RES_OK || set_validate(s)!=RES_OK) return false;\r\n    banks=s->board_type==40?6u:(uint8_t)(s->channel_count/8u);\r\n    if(c->bank_count!=banks) return false;\r\n    for(i=0;i<banks;++i) if(c->ref_ppm[i]==CAL_MISSING) return false;\r\n    for(i=0;i<s->channel_count;++i) if(s->ch[i].type!=CH_TYPE_OFF) {\r\n        /* PT100 calibration/tag format is not specified; fail closed until F0-40. */\r\n        if(s->ch[i].type==CH_TYPE_PT100 || c->baseline_nV[i]==CAL_MISSING ||\r\n           c->tag[i]!=(uint8_t)((s->ch[i].type_epoch<<2)|(uint8_t)s->ch[i].type)) return false;\r\n    }\r\n    return true;\r\n}\r\nres_t cal_learn(calibration_t *c, const settings_t *s, const int32_t baseline_nV[MAX_CHANNELS])\r\n{\r\n    uint8_t i;\r\n    if(cal_validate(c)!=RES_OK || set_validate(s)!=RES_OK || baseline_nV==NULL) return RES_ERR_RANGE;\r\n    for(i=0;i<s->channel_count;++i) if(s->ch[i].type!=CH_TYPE_OFF &&\r\n        (s->ch[i].type==CH_TYPE_PT100 || baseline_nV[i]<1500000 || baseline_nV[i]>10000000)) return RES_ERR_RANGE;\r\n    for(i=0;i<s->channel_count;++i) if(s->ch[i].type!=CH_TYPE_OFF) {\r\n        c->baseline_nV[i]=baseline_nV[i];\r\n        c->tag[i]=(uint8_t)((s->ch[i].type_epoch<<2)|(uint8_t)s->ch[i].type);\r\n    }\r\n    return RES_OK;\r\n}\r\n#ifndef FAMILY_SETTINGS_H\r\n#define FAMILY_SETTINGS_H\r\n#include \"common/types.h\"\r\n#include \"common/fault_codes.h\"\r\n#include <stddef.h>\r\n\r\n#define SETTINGS_SLOT_SIZE 768u\r\n#define CAL_SLOT_SIZE 256u\r\n#define CAL_MISSING INT32_MAX\r\ntypedef struct {\r\n    ch_type_t type;\r\n    ch_mode_t mode;\r\n    char name[6];\r\n    temp_dC_t alarm_dC, trip_dC, probe_limit_dC;\r\n    uint8_t band_C, type_epoch;\r\n} chan_cfg_t;\r\ntypedef struct {\r\n    uint8_t board_type, channel_count, address, baud;\r\n    uint16_t pin_bcd;\r\n    uint32_t sequence;\r\n    chan_cfg_t ch[MAX_CHANNELS];\r\n} settings_t;\r\ntypedef struct {\r\n    uint8_t bank_count;\r\n    uint32_t sequence;\r\n    int32_t ref_ppm[MAX_BANKS], baseline_nV[MAX_CHANNELS];\r\n    uint8_t tag[MAX_CHANNELS];\r\n} calibration_t;\r\n\r\n/* Pure, whole-record semantic validation; no defaults or partial acceptance. */\r\nres_t set_validate(const settings_t *s);\r\nuint16_t set_crc16(const uint8_t *p, size_t n);\r\nuint16_t set_crc16_continue(uint16_t crc,const uint8_t *p,size_t n);\r\n/* Bounded preparation primitives; pack parts require previously validated,\r\n * immutable inputs and an output cleared by the caller. */\r\nres_t set_validate_part(const settings_t *s,uint8_t first,uint8_t count,bool *fitted);\r\nres_t set_pack_part(const settings_t *s,uint8_t *out,uint8_t first,uint8_t count);\r\nres_t cal_pack_part(const calibration_t *c,uint8_t *out,uint8_t first,uint8_t count);\r\n/* Slots are little endian; trailing bytes are zero; unpack checks build identity. */\r\nres_t set_pack(const settings_t *s, uint8_t out[SETTINGS_SLOT_SIZE]);\r\nres_t set_unpack(const uint8_t in[SETTINGS_SLOT_SIZE], uint8_t board_type,\r\n                 uint8_t channel_count, settings_t *s);\r\n/* -1 neither valid, 0 A, 1 B; equal/half-range sequences deterministically prefer A. */\r\nint set_select(bool a_valid, uint32_t a_seq, bool b_valid, uint32_t b_seq);\r\nbool set_protection_changed(const settings_t *a, const settings_t *b);\r\n/* Edit helper: increments epoch on a change, clears limits; OFF is canonical. */\r\nres_t set_change_type(chan_cfg_t *c, ch_type_t type);\r\nres_t cal_validate(const calibration_t *c);\r\nres_t cal_pack(const calibration_t *c, uint8_t out[CAL_SLOT_SIZE]);\r\nres_t cal_unpack(const uint8_t in[CAL_SLOT_SIZE], uint8_t banks, calibration_t *c);\r\n/* Staged records may validate but must be complete and type/epoch-bound to run. */\r\nbool cal_complete(const calibration_t *c, const settings_t *s);\r\n/* All-or-nothing burnout update, absolute window 1.5..10 mV. */\r\nres_t cal_learn(calibration_t *c, const settings_t *s,\r\n                const int32_t baseline_nV[MAX_CHANNELS]);\r\n\r\ntypedef enum { STORE_IDLE, STORE_INVALIDATE, STORE_BODY, STORE_MAGIC,\r\n               STORE_VERIFY, STORE_DONE, STORE_FAILED, STORE_PREPARE } store_phase_t;\r\ntypedef enum { EE_NONE, EE_WRITE, EE_READ } ee_kind_t;\r\ntypedef struct { ee_kind_t kind; uint16_t address; uint8_t value; } ee_op_t;\r\ntypedef struct {\r\n    store_phase_t phase;\r\n    uint8_t image[SETTINGS_SLOT_SIZE];\r\n    uint8_t wrap_cal_image[CAL_SLOT_SIZE];\r\n    uint16_t length, index, base;\r\n    uint8_t active_slot, target_slot, retries;\r\n    bool pending, protection_change, calibration;\r\n    bool settings_after_cal;\r\n    uint8_t calibration_active_slot;\r\n    bool calibration_slot_known;\r\n    fault_code_t fault;\r\n    const settings_t *prep_candidate,*prep_active;\r\n    const calibration_t *prep_cal;\r\n    uint32_t prep_sequence;\r\n    uint16_t prep_position,prep_crc;\r\n    uint8_t prep_stage,prep_cursor,prep_cal_slot,prep_wrap_mask[(MAX_CHANNELS+7u)/8u];\r\n    bool prep_wrap,prep_fitted,prep_cal_only;\r\n} set_store_t;\r\n/* Initialize once per boot. Do not reinitialize to retry a failed commit. */\r\nvoid set_store_init(set_store_t *st);\r\n/* Begin rejects invalid RAM data; sequence is active+1. Caller must inhibit RUN\r\n * BEFORE executing the first emitted operation if protection_change is true.\r\n * active_slot = 0/1, or 2 for blank EEPROM. No settings pointer flip until STORE_DONE.\r\n * An in-progress transaction returns RES_BUSY; failures survive a new attempt. */\r\nres_t set_commit(set_store_t *st, const settings_t *candidate,\r\n                 const settings_t *active, uint8_t active_slot);\r\n/* Required for a type-epoch wrap; plain set_commit rejects that change.\r\n * Copies the active calibration (valid staged records allowed; slot 0/1), clears\r\n * every wrapping channel's baseline/tag, and verifies its inactive A/B copy BEFORE\r\n * writing settings. image remains the pending settings image; calibration=true\r\n * during the prerequisite write. active_slot is the SETTINGS slot throughout;\r\n * calibration_active_slot advances after calibration verification. STORE_DONE\r\n * means both records verified; no caller-owned input must survive begin.\r\n * Retries must pass that verified slot and its calibration record; a stale\r\n * calibration slot is rejected. Keep this store state across attempts.\r\n * On reset, boot-select both A/B pairs normally. A cut can leave old settings\r\n * with a newly cleared baseline (requiring re-learning), never wrapped settings\r\n * with the ancient baseline. Non-wrapping saves follow set_commit unchanged. */\r\nres_t set_commit_with_cal(set_store_t *st, const settings_t *candidate,\r\n                          const settings_t *active, uint8_t active_slot,\r\n                          const calibration_t *active_cal, uint8_t cal_slot);\r\n/* Also rejects a stale calibration slot once this store has verified a copy. */\r\nres_t cal_commit(set_store_t *st, const calibration_t *candidate,\r\n                 uint32_t active_sequence, uint8_t active_slot);\r\n/* Real-loop begin: no EEPROM operation until bounded preparation completes.\r\n * Inputs must remain immutable while phase==STORE_PREPARE. The sole EEPROM\r\n * owner enforces this lifetime using its settings mailbox/service candidate.\r\n * protection_change is available immediately; semantic failures enter FAILED.\r\n * The synchronous APIs above retain their complete-image-on-return contract. */\r\nres_t set_prepare_with_cal(set_store_t *st,const settings_t *candidate,\r\n    const settings_t *active,uint8_t active_slot,const calibration_t *cal,uint8_t cal_slot);\r\nres_t cal_prepare(set_store_t *st,const calibration_t *candidate,uint32_t sequence,uint8_t slot);\r\n/* Pure EEPROM protocol: execute op once; next call acknowledges it with ready,\r\n * success and (for EE_READ) value. ready=false preserves the outstanding op.\r\n * At most one byte request per call. Fault stays raised until successful retry. */\r\nvoid set_store_step(set_store_t *st, bool ready, bool success, uint8_t value,\r\n                    ee_op_t *op);\r\n#endif\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content firmware/family/src/services/settings_store.c; Get-Content firmware/family/test/integration/test_review.c -Head 90; Get-Content firmware/family/test/integration/avr_mcal_cycles.c'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content firmware/family/src/services/settings_store.c; Get-Content firmware/family/test/integration/test_review.c -Head 90; Get-Content firmware/family/test/integration/avr_mcal_cycles.c'","aggregated_output":"#include \"services/settings.h\"\r\n#include \"settings_bytes.h\"\r\n#include <string.h>\r\nvoid set_store_init(set_store_t *st)\r\n{\r\n    if(st!=NULL) { memset(st,0,sizeof(*st)); st->active_slot=2; st->calibration_active_slot=2; }\r\n}\r\nstatic bool available(const set_store_t *st)\r\n{ return st->phase==STORE_IDLE || st->phase==STORE_DONE || st->phase==STORE_FAILED; }\r\nstatic void begin(set_store_t *s, uint8_t active, uint16_t size, bool cal, bool prot)\r\n{\r\n    s->phase=STORE_INVALIDATE; s->active_slot=active;\r\n    s->target_slot=active==0?1:0;\r\n    s->base=(uint16_t)(cal?(0x640u+256u*s->target_slot):(0x40u+768u*s->target_slot));\r\n    s->length=size; s->index=2; s->pending=false; s->retries=0;\r\n    s->calibration=cal; s->protection_change=prot;\r\n    s->settings_after_cal=false;\r\n    if(cal) { s->calibration_active_slot=active; s->calibration_slot_known=true; }\r\n}\r\nstatic res_t settings_commit(set_store_t *st, const settings_t *candidate,\r\n                             const settings_t *active, uint8_t active_slot,\r\n                             const calibration_t *cal, uint8_t cal_slot)\r\n{\r\n    settings_t next; calibration_t next_cal; uint8_t i; bool wraps=false;\r\n    if(st==NULL || active_slot>2 || set_validate(candidate)!=RES_OK) return RES_ERR_RANGE;\r\n    if(!available(st)) return RES_BUSY;\r\n    if(active!=NULL) {\r\n        if(active_slot>1 || set_validate(active)!=RES_OK || candidate->board_type!=active->board_type ||\r\n           candidate->channel_count!=active->channel_count) return RES_ERR_RANGE;\r\n        /* Epoch changes are enforced at the commit boundary, not trusted to UI. */\r\n        for(i=0;i<active->channel_count;++i) {\r\n            uint8_t expected=active->ch[i].type_epoch;\r\n            if(active->ch[i].type!=candidate->ch[i].type) expected=(uint8_t)((expected+1u)&63u);\r\n            if(candidate->ch[i].type_epoch!=expected) return RES_ERR_RANGE;\r\n            if(active->ch[i].type_epoch==63 && expected==0) wraps=true;\r\n        }\r\n    } else if(active_slot!=2) return RES_ERR_RANGE;\r\n    if(wraps) {\r\n        uint8_t banks=candidate->board_type==40?6u:(uint8_t)(candidate->channel_count/8u);\r\n        if(cal_slot>1 || cal_validate(cal)!=RES_OK || cal->bank_count!=banks) return RES_ERR_RANGE;\r\n        /* A settings verification failure may leave its copy boot-selectable.\r\n         * Never overwrite the verified cleared calibration using a stale slot\r\n         * on retry: that would briefly expose the ancient baseline again. */\r\n        if(st->calibration_slot_known && cal_slot!=st->calibration_active_slot) return RES_ERR_RANGE;\r\n        next_cal=*cal; next_cal.sequence=cal->sequence+1u;\r\n        for(i=0;i<active->channel_count;++i)\r\n            if(active->ch[i].type_epoch==63 && candidate->ch[i].type_epoch==0) {\r\n                next_cal.baseline_nV[i]=CAL_MISSING; next_cal.tag[i]=0;\r\n            }\r\n        if(cal_pack(&next_cal,st->wrap_cal_image)!=RES_OK) return RES_ERR_RANGE;\r\n    }\r\n    next=*candidate; next.sequence=active?active->sequence+1u:0;\r\n    if(set_pack(&next,st->image)!=RES_OK) return RES_ERR_RANGE;\r\n    begin(st,active_slot,(uint16_t)(18u+16u*next.channel_count),false,set_protection_changed(active,&next));\r\n    if(wraps) {\r\n        begin(st,cal_slot,249,true,true);\r\n        st->active_slot=active_slot; st->settings_after_cal=true;\r\n    }\r\n    return RES_OK;\r\n}\r\nres_t set_commit(set_store_t *st, const settings_t *candidate, const settings_t *active, uint8_t active_slot)\r\n{\r\n    return settings_commit(st,candidate,active,active_slot,NULL,2);\r\n}\r\nres_t set_commit_with_cal(set_store_t *st, const settings_t *candidate,\r\n                          const settings_t *active, uint8_t active_slot,\r\n                          const calibration_t *active_cal, uint8_t cal_slot)\r\n{\r\n    return settings_commit(st,candidate,active,active_slot,active_cal,cal_slot);\r\n}\r\nres_t cal_commit(set_store_t *st, const calibration_t *candidate, uint32_t active_sequence, uint8_t active_slot)\r\n{\r\n    calibration_t next;\r\n    if(st==NULL || active_slot>2 || cal_validate(candidate)!=RES_OK) return RES_ERR_RANGE;\r\n    if(!available(st)) return RES_BUSY;\r\n    if(st->calibration_slot_known && active_slot!=st->calibration_active_slot) return RES_ERR_RANGE;\r\n    next=*candidate; next.sequence=active_slot==2?0:active_sequence+1u;\r\n    if(cal_pack(&next,st->image)!=RES_OK) return RES_ERR_RANGE;\r\n    begin(st,active_slot,249,true,true); return RES_OK;\r\n}\r\nenum { PREP_NEW,PREP_OLD,PREP_EPOCH,PREP_CAL_CHECK,PREP_ZERO,PREP_SETTINGS,\r\n       PREP_CAL,PREP_SETTINGS_CRC,PREP_CAL_CRC,PREP_FINISH };\r\nres_t set_prepare_with_cal(set_store_t *s,const settings_t *candidate,const settings_t *active,\r\n                          uint8_t slot,const calibration_t *cal,uint8_t cal_slot)\r\n{\r\n    if(!s || !candidate || slot>2 || candidate->channel_count>MAX_CHANNELS) return RES_ERR_RANGE;\r\n    if(!available(s)) return RES_BUSY;\r\n    if(active?(slot>1 || active->channel_count!=candidate->channel_count || active->board_type!=candidate->board_type):slot!=2)\r\n        return RES_ERR_RANGE;\r\n    s->protection_change=set_protection_changed(active,candidate);\r\n    s->prep_candidate=candidate; s->prep_active=active; s->prep_cal=cal;\r\n    s->prep_sequence=active?active->sequence+1u:0; s->prep_cal_slot=cal_slot;\r\n    s->active_slot=slot; s->phase=STORE_PREPARE; s->prep_stage=PREP_NEW;\r\n    s->prep_cursor=0; s->prep_position=0; s->prep_fitted=s->prep_wrap=s->prep_cal_only=false;\r\n    s->pending=false; s->calibration=false;\r\n    memset(s->prep_wrap_mask,0,sizeof s->prep_wrap_mask); return RES_OK;\r\n}\r\nres_t cal_prepare(set_store_t *s,const calibration_t *candidate,uint32_t sequence,uint8_t slot)\r\n{\r\n    if(!s || !candidate || slot>2) return RES_ERR_RANGE;\r\n    if(!available(s)) return RES_BUSY;\r\n    if(s->calibration_slot_known && slot!=s->calibration_active_slot) return RES_ERR_RANGE;\r\n    s->prep_cal=candidate; s->prep_candidate=s->prep_active=NULL;\r\n    s->prep_sequence=slot==2?0:sequence+1u; s->active_slot=slot;\r\n    s->protection_change=s->calibration=s->prep_cal_only=true;\r\n    s->pending=s->prep_wrap=false; s->prep_position=0; s->prep_cursor=0;\r\n    s->phase=STORE_PREPARE; s->prep_stage=PREP_CAL_CHECK; return RES_OK;\r\n}\r\nstatic void prepare_fail(set_store_t *s)\r\n{\r\n    s->phase=STORE_FAILED;\r\n    if(s->fault!=FC_G02_SAVE_FAIL_PROT) s->fault=s->protection_change?FC_G02_SAVE_FAIL_PROT:FC_G13_SAVE_FAIL_INFO;\r\n}\r\nstatic void prepare_step(set_store_t *s)\r\n{\r\n    uint8_t n,i; uint16_t end; uint8_t *out;\r\n    const settings_t *cfg=s->prep_candidate,*old=s->prep_active;\r\n    const calibration_t *cal=s->prep_cal;\r\n    switch(s->prep_stage) {\r\n    case PREP_NEW: case PREP_OLD: {\r\n        const settings_t *p=s->prep_stage==PREP_NEW?cfg:old;\r\n        n=(uint8_t)(p->channel_count-s->prep_cursor); if(n>4) n=4;\r\n        if(set_validate_part(p,s->prep_cursor,n,&s->prep_fitted)!=RES_OK) { prepare_fail(s); return; }\r\n        s->prep_cursor=(uint8_t)(s->prep_cursor+n);\r\n        if(s->prep_cursor<p->channel_count) return;\r\n        if(!s->prep_fitted) { prepare_fail(s); return; }\r\n        s->prep_stage=(uint8_t)(s->prep_stage==PREP_NEW && old?PREP_OLD:PREP_EPOCH);\r\n        s->prep_cursor=0; s->prep_fitted=false; return;\r\n    }\r\n    case PREP_EPOCH:\r\n        if(old) {\r\n            end=(uint16_t)(s->prep_cursor+4u); if(end>cfg->channel_count) end=cfg->channel_count;\r\n            for(i=s->prep_cursor;i<end;i++) {\r\n                uint8_t expected=old->ch[i].type_epoch;\r\n                if(old->ch[i].type!=cfg->ch[i].type) expected=(uint8_t)((expected+1u)&63u);\r\n                if(expected!=cfg->ch[i].type_epoch) { prepare_fail(s); return; }\r\n                if(old->ch[i].type_epoch==63 && expected==0) {\r\n                    s->prep_wrap=true; s->prep_wrap_mask[i/8u]|=(uint8_t)(1u<<(i%8u));\r\n                }\r\n            }\r\n            s->prep_cursor=(uint8_t)end; if(end<cfg->channel_count) return;\r\n        }\r\n        s->prep_stage=PREP_CAL_CHECK; return;\r\n    case PREP_CAL_CHECK:\r\n        if(s->prep_wrap || s->prep_cal_only) {\r\n            if(cal_validate(cal)!=RES_OK || (s->prep_wrap &&\r\n               (s->prep_cal_slot>1 || cal->bank_count!=(cfg->board_type==40?6u:cfg->channel_count/8u) ||\r\n                (s->calibration_slot_known && s->prep_cal_slot!=s->calibration_active_slot)))) {\r\n                prepare_fail(s); return;\r\n            }\r\n        }\r\n        s->prep_stage=PREP_ZERO; s->prep_position=0; return;\r\n    case PREP_ZERO:\r\n        out=s->prep_position<SETTINGS_SLOT_SIZE?s->image+s->prep_position:s->wrap_cal_image+s->prep_position-SETTINGS_SLOT_SIZE;\r\n        memset(out,0,64); s->prep_position+=64;\r\n        if(s->prep_position<(s->prep_wrap?SETTINGS_SLOT_SIZE+CAL_SLOT_SIZE:SETTINGS_SLOT_SIZE)) return;\r\n        s->prep_cursor=0; s->prep_stage=s->prep_cal_only?PREP_CAL:PREP_SETTINGS; return;\r\n    case PREP_SETTINGS:\r\n        n=(uint8_t)(cfg->channel_count-s->prep_cursor); if(n>4) n=4;\r\n        if(set_pack_part(cfg,s->image,s->prep_cursor,n)!=RES_OK) { prepare_fail(s); return; }\r\n        if(s->prep_cursor==0) put32(s->image+6,s->prep_sequence);\r\n        s->prep_cursor=(uint8_t)(s->prep_cursor+n);\r\n        if(s->prep_cursor<cfg->channel_count) return;\r\n        s->prep_cursor=0; s->prep_position=0; s->prep_crc=0xFFFF;\r\n        s->prep_stage=s->prep_wrap?PREP_CAL:PREP_SETTINGS_CRC; return;\r\n    case PREP_CAL:\r\n        out=s->prep_cal_only?s->image:s->wrap_cal_image;\r\n        n=(uint8_t)(MAX_BANKS+MAX_CHANNELS-s->prep_cursor); if(n>8) n=8;\r\n        if(cal_pack_part(cal,out,s->prep_cursor,n)!=RES_OK) { prepare_fail(s); return; }\r\n        if(s->prep_cursor==0) put32(out+4,s->prep_cal_only?s->prep_sequence:cal->sequence+1u);\r\n        for(i=s->prep_cursor;i<(uint8_t)(s->prep_cursor+n);i++) if(i>=MAX_BANKS && s->prep_wrap) {\r\n            uint8_t ch=(uint8_t)(i-MAX_BANKS);\r\n            if(s->prep_wrap_mask[ch/8u]&(1u<<(ch%8u))) { put32(out+32u+4u*ch,(uint32_t)CAL_MISSING); out[204u+ch]=0; }\r\n        }\r\n        s->prep_cursor=(uint8_t)(s->prep_cursor+n);\r\n        if(s->prep_cursor<MAX_BANKS+MAX_CHANNELS) return;\r\n        s->prep_position=0; s->prep_crc=0xFFFF;\r\n        s->prep_stage=s->prep_cal_only?PREP_CAL_CRC:PREP_SETTINGS_CRC; return;\r\n    case PREP_SETTINGS_CRC: case PREP_CAL_CRC:\r\n        out=s->prep_stage==PREP_SETTINGS_CRC || s->prep_cal_only?s->image:s->wrap_cal_image;\r\n        end=s->prep_stage==PREP_SETTINGS_CRC?(uint16_t)(16u+16u*cfg->channel_count):247;\r\n        n=(uint8_t)(end-s->prep_position>16?16:end-s->prep_position);\r\n        s->prep_crc=set_crc16_continue(s->prep_crc,out+s->prep_position,n); s->prep_position+=n;\r\n        if(s->prep_position<end) return;\r\n        put16(out+end,s->prep_crc); s->prep_position=0; s->prep_crc=0xFFFF;\r\n        s->prep_stage=s->prep_stage==PREP_SETTINGS_CRC && s->prep_wrap?PREP_CAL_CRC:PREP_FINISH; return;\r\n    case PREP_FINISH: {\r\n        uint8_t slot=s->active_slot; bool prot=s->protection_change;\r\n        if(s->prep_cal_only) begin(s,slot,249,true,true);\r\n        else {\r\n            begin(s,slot,(uint16_t)(18u+16u*cfg->channel_count),false,prot);\r\n            if(s->prep_wrap) { begin(s,s->prep_cal_slot,249,true,true); s->active_slot=slot; s->settings_after_cal=true; }\r\n        }\r\n        s->prep_candidate=s->prep_active=NULL; s->prep_cal=NULL; return;\r\n    }\r\n    default: prepare_fail(s); return;\r\n    }\r\n}\r\nstatic void retry_or_fail(set_store_t *s)\r\n{\r\n    s->pending=false;\r\n    if(s->fault!=FC_G02_SAVE_FAIL_PROT) s->fault=s->protection_change?FC_G02_SAVE_FAIL_PROT:FC_G13_SAVE_FAIL_INFO;\r\n    if(s->retries==0) { s->retries=1; s->phase=STORE_INVALIDATE; s->index=2; }\r\n    else s->phase=STORE_FAILED;\r\n}\r\nstatic const uint8_t *store_image(const set_store_t *s)\r\n{ return s->settings_after_cal?s->wrap_cal_image:s->image; }\r\nvoid set_store_step(set_store_t *s, bool ready, bool success, uint8_t value, ee_op_t *op)\r\n{\r\n    if(op==NULL) return;\r\n    memset(op,0,sizeof(*op));\r\n    if(s==NULL || !ready) return;\r\n    if(s->phase==STORE_PREPARE) { prepare_step(s); return; }\r\n    if(s->phase==STORE_IDLE || s->phase==STORE_DONE || s->phase==STORE_FAILED) return;\r\n    if(s->pending) {\r\n        s->pending=false;\r\n        if(!success || (s->phase==STORE_VERIFY && value!=store_image(s)[s->index])) retry_or_fail(s);\r\n        else switch(s->phase) {\r\n        case STORE_INVALIDATE: s->phase=STORE_BODY; s->index=2; break;\r\n        case STORE_BODY:\r\n            ++s->index;\r\n            if(s->index==s->length) { s->phase=STORE_MAGIC; s->index=1; }\r\n            break;\r\n        case STORE_MAGIC:\r\n            if(s->index==1) s->index=0;\r\n            else { s->phase=STORE_VERIFY; s->index=0; }\r\n            break;\r\n        case STORE_VERIFY:\r\n            ++s->index;\r\n            if(s->index==s->length) {\r\n                if(s->settings_after_cal) {\r\n                    uint8_t settings_slot=s->active_slot, cal_slot=s->target_slot;\r\n                    begin(s,settings_slot,(uint16_t)(18u+16u*s->image[4]),false,true);\r\n                    s->calibration_active_slot=cal_slot;\r\n                } else {\r\n                    s->phase=STORE_DONE; s->active_slot=s->target_slot;\r\n                    if(s->calibration) s->calibration_active_slot=s->target_slot;\r\n                    if(s->fault!=FC_G02_SAVE_FAIL_PROT || s->protection_change) s->fault=FC_NONE;\r\n                }\r\n            }\r\n            break;\r\n        default: retry_or_fail(s); break;\r\n        }\r\n    }\r\n    switch(s->phase) {\r\n    case STORE_INVALIDATE: op->kind=EE_WRITE; op->address=s->base; op->value=0; break;\r\n    case STORE_BODY: case STORE_MAGIC:\r\n        op->kind=EE_WRITE; op->address=(uint16_t)(s->base+s->index); op->value=store_image(s)[s->index]; break;\r\n    case STORE_VERIFY: op->kind=EE_READ; op->address=(uint16_t)(s->base+s->index); break;\r\n    case STORE_DONE: case STORE_FAILED: case STORE_IDLE: return;\r\n    default: s->phase=STORE_FAILED; s->fault=FC_G02_SAVE_FAIL_PROT; return;\r\n    }\r\n    s->pending=true;\r\n}\r\n#include \"app/app.h\"\r\n#include \"app/ack_input.h\"\r\n#include \"app/outputs_hw.h\"\r\n#include \"app/service.h\"\r\n#include \"app/ee_owner.h\"\r\n#include \"drivers/keys.h\"\r\n#include \"drivers/ad7124.h\"\r\n#include \"app/acquisition_budget.h\"\r\n#include \"drivers/relays.h\"\r\n#include \"services/scan.h\"\r\n#include \"mcal/timer.h\"\r\n#include \"fake_hw.h\"\r\n#include \"model.h\"\r\n#include <stdio.h>\r\n#include <stdlib.h>\r\n#include <string.h>\r\nstatic unsigned checks;\r\nunsigned settings_validation_count(void);\r\nstatic void fail(unsigned line,const char *expr) {\r\n    uint8_t unit; fault_code_t cause=fault_first_trip(app_faults(),&unit);\r\n    printf(\"review FAIL %u: %s mode=%u ack=%u active=%u/%u\\n\",line,expr,f0_mode(),app_ack_reason(),cause,unit); exit(1);\r\n}\r\n#define CHECK(x) do { ++checks; if(!(x)) fail(__LINE__,#x); } while(0)\r\nstatic void loop(unsigned n) { unsigned i; for(i=0;i<n;i++) { f0_task(); fake_advance(1); } CHECK(!model_watchdog_reset()); }\r\nstatic void setup(bool service) {\r\n    settings_t cfg; calibration_t cal; uint8_t bytes[SETTINGS_SLOT_SIZE]; unsigned i;\r\n    fake_reset(); memset(&cfg,0,sizeof cfg); memset(&cal,0,sizeof cal);\r\n    cfg.board_type=cfg.channel_count=24; cfg.address=1; cfg.sequence=7; cal.bank_count=3;\r\n    for(i=0;i<MAX_CHANNELS;i++) { memcpy(cfg.ch[i].name,\"      \",6); cfg.ch[i].band_C=2; cal.baseline_nV[i]=CAL_MISSING; }\r\n    cfg.ch[0].type=CH_TYPE_K; cfg.ch[0].alarm_dC=800; cfg.ch[0].trip_dC=1000; cfg.ch[0].probe_limit_dC=12000;\r\n    cal.baseline_nV[0]=3200000; cal.tag[0]=1;\r\n    CHECK(set_pack(&cfg,bytes)==RES_OK); memcpy(fake_eeprom+0x40,bytes,sizeof bytes);\r\n    CHECK(cal_pack(&cal,bytes)==RES_OK); memcpy(fake_eeprom+0x640,bytes,CAL_SLOT_SIZE);\r\n    fake_pin(board()->keys[2],!service); f0_init(); loop(3000);\r\n}\r\nstatic void ack(void) {\r\n    fake_pin(board()->keys[3],true); loop(20); fake_pin(board()->keys[3],false); loop(70);\r\n    fake_pin(board()->keys[3],true); loop(20);\r\n}\r\nstatic void timestamp(void) {\r\n    prot_in_t in; memset(&in,0,sizeof in); setup(false); keys_init(); ack_input_init();\r\n    fake_advance(10); keys_task(); ack_input_step(&in);\r\n    fake_pin(board()->keys[3],false); fake_advance(8); keys_task();\r\n    fake_advance(1); ack_input_step(&in); /* tick between driver and adapter */\r\n    fake_advance(49); keys_task(); ack_input_step(&in);\r\n    CHECK(in.ack && in.ack_held_ms==50 && in.ack_age_ms==0);\r\n    fake_pin(board()->keys[3],true); keys_init(); ack_input_init();\r\n    fake_advance(10); keys_task(); ack_input_step(&in);\r\n    fake_pin(board()->keys[3],false); fake_advance(8); keys_task();\r\n    fake_advance(50); keys_task(); fake_advance(7); ack_input_step(&in);\r\n    CHECK(in.ack && in.ack_held_ms==50 && in.ack_age_ms==7);\r\n}\r\nstatic void expiry(void) {\r\n    unsigned i;\r\n    setup(false); ack(); loop(750); CHECK(timer_run_active());\r\n    timer_run_start(1); fake_advance(1); CHECK(!timer_run_active());\r\n    outputs_hw_apply(true,true,900); CHECK(!timer_run_active());\r\n    loop(1); CHECK(f0_mode()==TRIPPED && fault_latched_at(app_faults(),FC_G05_SCAN_DEADLINE,0));\r\n    loop(1500); CHECK(!timer_run_active()); ack(); CHECK(f0_mode()==RUN); loop(750); CHECK(timer_run_active());\r\n    model_expire_on_grant(); loop(750);\r\n    CHECK(f0_mode()==TRIPPED && !timer_run_active());\r\n    CHECK(fault_latched_at(app_faults(),FC_G05_SCAN_DEADLINE,0));\r\n    for(i=0;i<800 && fault_active(app_faults(),FC_G05_SCAN_DEADLINE);i++) loop(1);\r\n    CHECK(i<800 && !timer_run_active()); /* Cleared scan evidence alone cannot restart. */\r\n    ack(); CHECK(f0_mode()==RUN); loop(750); CHECK(timer_run_active());\r\n}\r\nstatic void service_key(bool escape) {\r\n    fake_pin(board()->keys[escape?0:2],false); if(escape) fake_pin(board()->keys[1],false);\r\n    loop(30); fake_pin(board()->keys[0],true); fake_pin(board()->keys[1],true); fake_pin(board()->keys[2],true); loop(220);\r\n}\r\nstatic void service_abort(void) {\r\n    unsigned step,key,i; settings_t candidate;\r\n    for(step=2;step<=4;step++) for(key=0;key<4;key++) {\r\n        setup(true); fake_pin(board()->keys[2],true); loop(9000); CHECK(svc_active_step()==1);\r\n        for(i=1;i<step;i++) service_key(true);\r\n        CHECK(svc_active_step()==step); service_key(false);\r\n        CHECK(step==2?relay_alarm_sense():step==3?timer_run_active():(fake_port(PORT_B)&8)!=0);\r\n        if(step==3 && key==2) {\r\n            candidate=*app_settings(); candidate.ch[0].name[0]='X';\r\n            CHECK(app_commit_settings(&candidate)==RES_OK);\r\n            fake_pin(board()->keys[key],false); fake_advance(8); loop(1);\r\n            CHECK(ee_owner_busy()); /* Commit notice and press in this pass. */\r\n        } else { fake_pin(board()->keys[key],false); loop(9); }\r\n        CHECK(!timer_run_active() && !(fake_port(PORT_B)&8) && !relay_alarm_sense());\r\n        CHECK(svc_active_step()==step+1); /* Still held: no release gesture. */\r\n    }\r\n}\r\nstatic void adc_verifier(void) {\r\n    setup(false); fake_ad_reg(0,5,0);\r\n    CHECK(ad_verify_mutable_part(0,17)==RES_ERR_ID);\r\n/* Cycle calibration of the unmodified target MCAL in GNU's AVR simulator.\r\n * Hardware registers are RAM in this simulator; explicitly set input levels. */\r\n#include \"mcal/gpio.h\"\r\n#include \"mcal/spi.h\"\r\n#include \"mcal/timer.h\"\r\n#include \"drivers/keys.h\"\r\n#include <avr/io.h>\r\nvolatile uint8_t cycle_kind,cycle_value;\r\nvolatile uint16_t cycle_errors;\r\n__attribute__((noinline)) void cycle_begin(void) { __asm__ volatile(\"nop\"); }\r\n__attribute__((noinline)) void cycle_end(void) { __asm__ volatile(\"nop\"); }\r\n__attribute__((noinline)) void cycle_done(void) { for(;;) __asm__ volatile(\"nop\"); }\r\nvoid TIMER2_COMPA_vect(void);\r\nint main(void) {\r\n    uint16_t i; gpio_init(); timer_init(); keys_init();\r\n    PINA=PINB=PINC=PIND=255;\r\n    for(i=0;i<256;i++) {\r\n        PORTB=0x9F;\r\n        cycle_value=(uint8_t)i; cycle_kind=9;\r\n        cycle_begin(); uint8_t rx=spi_soft_xfer((uint8_t)i); cycle_end();\r\n        if(rx!=255 || (PORTB&0x9Fu)!=0x9Fu) ++cycle_errors;\r\n    }\r\n    PINB=0; if(spi_soft_xfer(0)!=0) ++cycle_errors; PINB=255;\r\n    cycle_kind=2; cycle_begin(); gpio_write(PIN(PORT_D,7),true); cycle_end();\r\n    cycle_kind=3; cycle_begin(); (void)gpio_read(PIN(PORT_D,7)); cycle_end();\r\n    cycle_kind=4; cycle_begin(); gpio_mask(PORT_A,255,255); cycle_end();\r\n    cycle_kind=5; cycle_begin(); delay_us(49); cycle_end();\r\n    cycle_kind=11; cycle_begin(); (void)tick_ms(); cycle_end();\r\n    cycle_kind=13; cycle_begin(); (void)timer_run_start_at(900,tick_ms()); cycle_end();\r\n    cycle_kind=15; cycle_begin(); (void)timer_run_remaining(); cycle_end();\r\n    cycle_kind=16; cycle_begin(); (void)timer_run_active(); cycle_end();\r\n    cycle_kind=32; cycle_begin(); TIMER2_COMPA_vect(); cycle_end();\r\n    cycle_done();\r\n}\r\n","exit_code":0,"status":"completed"}}
