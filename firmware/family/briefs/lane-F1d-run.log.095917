{"type":"item.completed","item":{"id":"item_97","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content firmware/family/include/services/events.h; Get-Content firmware/family/src/services/events.c -Head 75; Get-Content firmware/family/src/services/scan.c -Head 30; Get-Content firmware/family/test/integration/model.c -Head 50'","aggregated_output":"#ifndef FAMILY_EVENTS_H\r\n#define FAMILY_EVENTS_H\r\n#include \"common/types.h\"\r\n#include \"common/fault_codes.h\"\r\n#define EVENT_SLOTS 32u\r\ntypedef enum { EV_POWER_UP=1, EV_TRIP, EV_ALARM, EV_FAULT, EV_ACK,\r\n               EV_SETTINGS_CHANGED, EV_NAME_CHANGED, EV_SERVICE_ENTRY,\r\n               EV_CALIBRATION, EV_PIN_RESET } event_type_t;\r\ntypedef struct {\r\n    uint16_t sequence, power_cycles;\r\n    event_type_t type;\r\n    fault_code_t code;\r\n    uint8_t channel, unit;\r\n    uint32_t uptime_s;\r\n    temp_dC_t value_dC, threshold_dC;\r\n} event_t;\r\ntypedef struct { uint8_t slot[EVENT_SLOTS][16]; } events_t;\r\nuint8_t ev_crc8(const uint8_t *p, uint8_t n);\r\nres_t ev_pack(const event_t *e, uint8_t out[16]);\r\nres_t ev_unpack(const uint8_t in[16], event_t *e);\r\n/* Return physical newest slot, or -1 if none; CRC failures are skipped. */\r\nint ev_newest(const events_t *r);\r\n/* Pure RAM ring; caller persists the returned physical slot, one entry per transition. */\r\nint ev_log(events_t *r, const event_t *e);\r\nres_t ev_get(const events_t *r, uint8_t age, event_t *e);\r\n#endif\r\n#include \"services/events.h\"\r\n#include \"settings_bytes.h\"\r\n#include <stddef.h>\r\nuint8_t ev_crc8(const uint8_t *p, uint8_t n)\r\n{\r\n    uint8_t crc=0, i, b;\r\n    if(p==NULL) return 0;\r\n    for(i=0;i<n;++i) {\r\n        crc^=p[i];\r\n        for(b=0;b<8;++b) crc=(uint8_t)((crc&0x80u)?((uint8_t)(crc<<1)^0x07u):(uint8_t)(crc<<1));\r\n    }\r\n    return crc;\r\n}\r\nres_t ev_pack(const event_t *e, uint8_t out[16])\r\n{\r\n    if(e==NULL || out==NULL || e->type<EV_POWER_UP || e->type>EV_PIN_RESET ||\r\n       (unsigned)e->code>FC_C11_OVER_ALARM || e->channel>MAX_CHANNELS) return RES_ERR_RANGE;\r\n    put16(out,e->sequence); out[2]=(uint8_t)e->type; out[3]=(uint8_t)e->code; out[4]=e->channel;\r\n    put16(out+5,e->power_cycles); out[7]=(uint8_t)e->uptime_s;\r\n    out[8]=(uint8_t)(e->uptime_s>>8); out[9]=(uint8_t)(e->uptime_s>>16);\r\n    put16(out+10,(uint16_t)e->value_dC); put16(out+12,(uint16_t)e->threshold_dC);\r\n    out[14]=e->unit; out[15]=ev_crc8(out,15); return RES_OK;\r\n}\r\nres_t ev_unpack(const uint8_t in[16], event_t *e)\r\n{\r\n    if(in==NULL || e==NULL) return RES_ERR_RANGE;\r\n    if(ev_crc8(in,15)!=in[15]) return RES_ERR_CRC;\r\n    if(in[2]<1 || in[2]>10 || in[3]>51 || in[4]>MAX_CHANNELS) return RES_ERR_RANGE;\r\n    e->sequence=get16(in); e->type=(event_type_t)in[2]; e->code=(fault_code_t)in[3];\r\n    e->channel=in[4]; e->power_cycles=get16(in+5);\r\n    e->uptime_s=(uint32_t)in[7]|((uint32_t)in[8]<<8)|((uint32_t)in[9]<<16);\r\n    e->value_dC=geti16(in+10); e->threshold_dC=geti16(in+12); e->unit=in[14]; return RES_OK;\r\n}\r\nint ev_newest(const events_t *r)\r\n{\r\n    int newest=-1; uint16_t seq=0; uint8_t i; event_t e;\r\n    if(r==NULL) return -1;\r\n    for(i=0;i<EVENT_SLOTS;++i) if(ev_unpack(r->slot[i],&e)==RES_OK) {\r\n        uint16_t delta=(uint16_t)(e.sequence-seq);\r\n        if(newest<0 || (delta!=0 && delta<0x8000u)) { newest=i; seq=e.sequence; }\r\n    }\r\n    return newest;\r\n}\r\nint ev_log(events_t *r, const event_t *e)\r\n{\r\n    int newest; event_t next, prev; uint8_t slot;\r\n    if(r==NULL || e==NULL) return -1;\r\n    newest=ev_newest(r); next=*e;\r\n    if(newest>=0) { (void)ev_unpack(r->slot[newest],&prev); next.sequence=(uint16_t)(prev.sequence+1u); }\r\n    else next.sequence=0;\r\n    slot=(uint8_t)((newest+1)%EVENT_SLOTS);\r\n    return ev_pack(&next,r->slot[slot])==RES_OK?(int)slot:-1;\r\n}\r\nres_t ev_get(const events_t *r, uint8_t age, event_t *e)\r\n{\r\n    int newest;\r\n    if(r==NULL || age>=EVENT_SLOTS || e==NULL) return RES_ERR_RANGE;\r\n    newest=ev_newest(r); if(newest<0) return RES_ERR_RANGE;\r\n    return ev_unpack(r->slot[((unsigned)newest+EVENT_SLOTS-age)%EVENT_SLOTS],e);\r\n}\r\n#include \"services/scan.h\"\r\n#include \"app/acquisition_budget.h\"\r\n#include \"app/cj_schedule.h\"\r\n#include \"services/tc_math.h\"\r\n#include \"drivers/ad7124.h\"\r\n#include \"drivers/tmp126.h\"\r\n#include \"mcal/gpio.h\"\r\n#include \"mcal/timer.h\"\r\n#include \"mcal/wdt.h\"\r\n#include \"board/board_cfg.h\"\r\n#include <string.h>\r\ntypedef enum { INIT_ADC, INIT_CJ, WAIT_CJ, REF_PRE, REF_HIGH, REF_LOW,\r\n               BEGIN_SCAN, BEGIN_BANK, START_SLOT, POLL_SLOT, END_SCAN, RECOVER } phase_t;\r\nstatic phase_t phase;\r\nstatic scan_out_t work,published;\r\nstatic scan_diag_t diag;\r\nstatic const settings_t *cfg;\r\nstatic const calibration_t *cal;\r\nstatic fault_registry_t *registry;\r\nstatic uint32_t start,progress,wait_start,pending,last_ref;\r\nstatic uint8_t initialized,slot,done,cj_index,end_index;\r\nstatic bool prior[MAX_BANKS],good[MAX_BANKS],verify_done[MAX_BANKS],reinit,transport[MAX_BANKS];\r\nstatic int32_t cj_mC[10];\r\nstatic bool cj_valid[10];\r\nstatic uint16_t cm_bad[MAX_BANKS];\r\nstatic void raise(fault_code_t f,uint8_t u) { if(registry && f!=FC_NONE) (void)fault_raise(registry,f,u); }\r\nstatic void bank_fault(uint8_t b,fault_code_t f) {\r\n    if(f==FC_NONE) f=FC_B05_ADC_STALLED;\r\n    good[b]=false; if(f!=FC_B06_REF) diag.cal_safe[b]=false; raise(f,b);\r\n}\r\n/* Reuse Lane A's register models unchanged, extending only the MCAL seam.\r\n * Legacy driver/unit tests use its original clock. Integration enables byte\r\n * write latency, Timer2 during I/O, watchdog and measured bus-time accounting. */\r\n#include \"fake_hw.h\"\r\n#include \"mcal/eeprom.h\"\r\n#include \"mcal/timer.h\"\r\n#include \"mcal/spi.h\"\r\n#include \"mcal/wdt.h\"\r\n#include \"drivers/keys.h\"\r\