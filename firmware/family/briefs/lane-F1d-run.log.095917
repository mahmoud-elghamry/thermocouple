{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content firmware/family/test/integration/profile_avr.ps1; Get-Content firmware/family/src/app/protection.c; Get-Content firmware/family/src/services/scan.c'","aggregated_output":"# Instruction cycles from the installed GNU AVR simulator, compiled at -Os.\r\nparam([string]$Gdb='C:/Users/malgh/.platformio/packages/toolchain-atmelavr/bin/avr-gdb.exe')\r\n$ErrorActionPreference='Stop'\r\n$root=(Resolve-Path (Join-Path $PSScriptRoot '../..')).Path\r\n$out=Join-Path $root 'build/profile'\r\nNew-Item -ItemType Directory -Force $out | Out-Null\r\n$bin='C:/Program Files (x86)/Labcenter Electronics/Proteus 8 Professional/Tools/ARDUINO/hardware/tools/avr/bin'\r\n# Keep unchanged register fakes small enough for AVR SRAM. Only the MCAL seam\r\n# differs: aliased fixture A/B slots, FF elsewhere, nonblocking byte writes.\r\n$header=(Get-Content \"$root/test/fakes/fake_hw.h\" -Raw).Replace('[4096]','[1024]').Replace('[16384]','[128]')\r\n[IO.File]::WriteAllText(\"$out/fake_hw.h\",$header)\r\n$fake=(Get-Content \"$root/test/fakes/fake_mcal.c\" -Raw).Replace('[4096]','[1024]').Replace('[16384]','[128]')\r\n$fake=$fake.Replace('static uint8_t ports','extern volatile uint32_t profile_delay; extern uint8_t profile_eeprom_read(uint16_t); extern void profile_eeprom_write(uint16_t,uint8_t);'+\"`n\"+'static uint8_t ports')\r\n$fake=$fake.Replace('us+=delay;','us+=delay; profile_delay+=delay;')\r\n$fake=$fake.Replace('return a<4096?fake_eeprom[a]:0xFF;','return profile_eeprom_read(a);')\r\n$fake=$fake.Replace('fake_eeprom[a]=v;','profile_eeprom_write(a,v);')\r\n$fake=$fake.Replace('if(uart_len>=sizeof fake_uart_log-1) return false;','if(uart_len>=sizeof fake_uart_log-1) uart_len=0;')\r\n$fake=$fake.Replace('static bool pump;','static bool pump,expired;')\r\n$fake=$fake.Replace('remaining=0; pump=false; }','remaining=0; pump=false; expired=false; }')\r\n$fake=$fake.Replace('if(remaining && --remaining==0) timer_run_stop();','if(remaining && --remaining==0) { expired=true; timer_run_stop(); }')\r\n$fake += @'\r\nbool timer_run_expired(void) { return expired; }\r\nvoid timer_run_ack_expiry(void) { if(!remaining && !pump) expired=false; }\r\nbool timer_run_start_at(uint16_t d,uint32_t at) {\r\n    uint32_t age=tick_ms()-at;\r\n    if(d && age>=d) expired=true;\r\n    if(expired || age>=d) { timer_run_stop(); return false; }\r\n    timer_run_start((uint16_t)(d-age)); return true;\r\n}\r\n'@\r\n[IO.File]::WriteAllText(\"$out/fake_mcal.c\",$fake)\r\n$sources=Get-Content \"$root/sources/hardware_avr.txt\" | Where-Object { $_ -and $_ -notmatch '^src/mcal/' } | ForEach-Object { \"$root/$_\" }\r\n$sources+=@(\"$PSScriptRoot/avr_mcal_wrap.c\",\"$root/test/fakes/fake_ad7124.c\",\"$root/test/fakes/fake_tmp126.c\",\"$PSScriptRoot/avr_profile.c\")\r\n& \"$bin/avr-gcc.exe\" '-std=c11' '-g' '-Os' '-Wall' '-Wextra' '-Werror' '-mmcu=atmega1284p' '-DF_CPU=8000000UL' '-DFAMILY_TEST' '-DFAMILY_REGISTER_MODEL' \"-I$out\" \"-I$root/include\" '-ffunction-sections' '-fdata-sections' '-Wl,--gc-sections' @sources '-o' \"$out/profile.elf\"\r\nif($LASTEXITCODE) { throw 'AVR profile compilation failed' }\r\n& \"$bin/avr-size.exe\" '-C' '--mcu=atmega1284p' \"$out/profile.elf\"\r\n& \"$bin/avr-objdump.exe\" '-d' \"$out/profile.elf\" | Out-File \"$out/disassembly.txt\" -Encoding ascii\r\n# This simulator misclassifies ELF avr:51 as a three-byte-PC AVR. avr:5 has\r\n# the same instruction timings and correct two-byte PC for ATmega1284P. Only\r\n# the simulator ELF architecture flag changes; no instruction bytes change.\r\n$elf=[IO.File]::ReadAllBytes(\"$out/profile.elf\")\r\nif(($elf[36] -band 127) -ne 51) { throw 'Unexpected AVR ELF architecture' }\r\n$elf[36]=($elf[36] -band 128) -bor 5\r\n[IO.File]::WriteAllBytes(\"$out/profile.elf\",$elf)\r\n& \"$bin/avr-objcopy.exe\" '-O' 'binary' '-j' '.data' \"$out/profile.elf\" \"$out/data.bin\"\r\n$commands=@'\r\ntarget sim\r\nload\r\nbreak main\r\nrun\r\nrestore DATA_FILE binary 0x800100\r\ndelete 1\r\nbreak profile_begin\r\ncommands\r\nsilent\r\nprintf \"BEGIN %u %u\\n\", profile_phase, profile_pass\r\ninfo target\r\nenable IO_BREAKS\r\ncontinue\r\nend\r\nbreak profile_end\r\ncommands\r\nsilent\r\nprintf \"END %u %u %lu %lu %lu\\n\", profile_phase, profile_pass, fake_spi_bytes, fake_soft_bytes, profile_delay\r\ninfo target\r\ndisable IO_BREAKS\r\ncontinue\r\nend\r\nbreak profile_done\r\n'@\r\n$commands=$commands.Replace('DATA_FILE',(\"$out/data.bin\" -replace '\\\\','/'))\r\n$names=@('gpio_init','gpio_write','gpio_read','gpio_mask','delay_us','spi_init','spi_enable','spi_xfer','spi_soft_xfer','timer_init','tick_ms','timer_run_start','timer_run_start_at','timer_run_stop','timer_run_remaining','timer_run_active','timer_run_expired','timer_run_ack_expiry','timer_run_static_high','wdt_feed','reset_cause','fuses_read','fuses_ok','flow_check','ee_read','ee_ready','ee_write_byte','uart_init','uart_put','uart_get','uart_tx_complete')\r\n$symbols=& \"$bin/avr-nm.exe\" '-S' '--defined-only' \"$out/profile.elf\"\r\n$ioCommands=''; $breakNo=5\r\nfor($n=0;$n -lt $names.Length;$n++) {\r\n    $symbol=$symbols | Where-Object { $_ -match ('\\s'+$names[$n]+'$') }\r\n    if(-not $symbol) { continue }\r\n    $words=$symbol.Trim() -split '\\s+'\r\n    $address=[Convert]::ToInt32($words[0],16); $size=[Convert]::ToInt32($words[1],16)\r\n    $ioCommands+=\"break *$($names[$n])`ncommands`nsilent`nif `$io_depth==0`nprintf `\"IO_BEGIN $($n+1) %u\\n`\", (unsigned int)`$r24+256*(unsigned int)`$r25`ninfo target`nend`nset `$io_depth=`$io_depth+1`ncontinue`nend`n\"\r\n    $ioCommands+=\"break *($($names[$n])+$($size-2))`ncommands`nsilent`nset `$io_depth=`$io_depth-1`nif `$io_depth==0`nprintf `\"IO_END\\n`\"`ninfo target`nend`ncontinue`nend`n\"\r\n    $breakNo+=2\r\n}\r\n$commands=$commands.Replace('IO_BREAKS',\"5-$($breakNo-1)\")\r\n$commands+=\"`n$ioCommands`nset `$io_depth=0`ndisable 5-$($breakNo-1)`ncontinue`nquit`n\"\r\n[IO.File]::WriteAllText(\"$out/profile.gdb\",$commands)\r\n& $env:ComSpec /d /s /c \"`\"$Gdb`\" -batch -x `\"$out/profile.gdb`\" `\"$out/profile.elf`\" > `\"$out/cycles.log`\" 2>&1\"\r\nif($LASTEXITCODE) { throw 'AVR simulator failed; inspect cycles.log' }\r\n# Measure the protected pure commit independently: no register fake is called.\r\n$commit=@'\r\ntarget sim\r\nload\r\nbreak main\r\nrun\r\nrestore DATA_FILE binary 0x800100\r\ndelete 1\r\nbreak set_prepare_with_cal\r\ncontinue\r\ninfo target\r\nfinish\r\ninfo target\r\nquit\r\n'@\r\n$commit=$commit.Replace('DATA_FILE',(\"$out/data.bin\" -replace '\\\\','/'))\r\n[IO.File]::WriteAllText(\"$out/commit.gdb\",$commit)\r\n& $env:ComSpec /d /s /c \"`\"$Gdb`\" -batch -x `\"$out/commit.gdb`\" `\"$out/profile.elf`\" > `\"$out/commit.log`\" 2>&1\"\r\nif($LASTEXITCODE) { throw 'Pure commit measurement failed' }\r\n$wrap=$commit.Replace('break set_prepare_with_cal','break set_prepare_with_cal if profile_phase==8')\r\n[IO.File]::WriteAllText(\"$out/wrap.gdb\",$wrap)\r\n& $env:ComSpec /d /s /c \"`\"$Gdb`\" -batch -x `\"$out/wrap.gdb`\" `\"$out/profile.elf`\" > `\"$out/wrap.log`\" 2>&1\"\r\nif($LASTEXITCODE) { throw 'Epoch-wrap commit measurement failed' }\r\n# Calibrate the actual GPIO/software-SPI/timer implementations, without fakes.\r\n& \"$bin/avr-gcc.exe\" '-std=c11' '-g' '-Os' '-Wall' '-Wextra' '-Werror' '-mmcu=atmega1284p' '-DF_CPU=8000000UL' \"-I$root/include\" \"$root/src/mcal/gpio.c\" \"$root/src/mcal/timer.c\" \"$root/src/mcal/spi.c\" \"$root/src/drivers/keys.c\" \"$root/src/board/board_cfg_24.c\" \"$PSScriptRoot/avr_mcal_cycles.c\" '-o' \"$out/mcal.elf\"\r\nif($LASTEXITCODE) { throw 'MCAL calibration compilation failed' }\r\n& \"$bin/avr-objcopy.exe\" '-O' 'binary' '-j' '.data' \"$out/mcal.elf\" \"$out/mcal_data.bin\"\r\n$elf=[IO.File]::ReadAllBytes(\"$out/mcal.elf\"); $elf[36]=($elf[36] -band 128) -bor 5\r\n[IO.File]::WriteAllBytes(\"$out/mcal.elf\",$elf)\r\n$mcal=@'\r\ntarget sim\r\nload\r\nbreak main\r\nrun\r\nrestore DATA_FILE binary 0x800100\r\ndelete 1\r\nbreak cycle_begin\r\ncommands\r\nsilent\r\nprintf \"BEGIN %u %u\\n\",cycle_kind,cycle_value\r\ninfo target\r\ncontinue\r\nend\r\nbreak cycle_end\r\ncommands\r\nsilent\r\nprintf \"END\\n\"\r\ninfo target\r\ncontinue\r\nend\r\nbreak cycle_done\r\ncontinue\r\nquit\r\n'@\r\n$mcal=$mcal.Replace('DATA_FILE',(\"$out/mcal_data.bin\" -replace '\\\\','/'))\r\n[IO.File]::WriteAllText(\"$out/mcal.gdb\",$mcal)\r\n& $env:ComSpec /d /s /c \"`\"$Gdb`\" -batch -x `\"$out/mcal.gdb`\" `\"$out/mcal.elf`\" > `\"$out/mcal.log`\" 2>&1\"\r\nif($LASTEXITCODE) { throw 'MCAL calibration simulation failed' }\r\npython \"$PSScriptRoot/profile_summary.py\" $out | Tee-Object -FilePath \"$out/summary.txt\"\r\nif($LASTEXITCODE) { throw 'Cycle report failed' }\r\n#include \"app/protection.h\"\r\n#include \"services/events.h\"\r\n#include <string.h>\r\n#define WINDOW_MS 900u\r\n#define EVENT_BIT(e) ((uint16_t)(1u<<((e)-1u)))\r\nstatic void mode_set(prot_state_t *s, prot_mode_t mode)\r\n{\r\n    s->mode=mode; s->mode_inv=(uint8_t)~(uint8_t)mode;\r\n    s->permit=(mode==RUN)?1:0; s->permit_inv=(uint8_t)~s->permit;\r\n    if(mode!=RUN) s->window_valid=false;\r\n}\r\nbool prot_integrity(const prot_state_t *s)\r\n{\r\n    return s!=NULL && (unsigned)s->mode<=SERVICE &&\r\n        (uint8_t)(s->mode_inv^(uint8_t)s->mode)==UINT8_MAX &&\r\n        (uint8_t)(s->permit_inv^s->permit)==UINT8_MAX &&\r\n        s->permit==((s->mode==RUN)?1u:0u);\r\n}\r\nvoid prot_init(prot_state_t *s, bool settings_ok, bool cal_ok, bool service)\r\n{\r\n    if(s==NULL) return;\r\n    memset(s,0,sizeof(*s)); mode_set(s,service?SERVICE:((settings_ok&&cal_ok)?START_LATCHED:CONFIG_LOCK));\r\n    memset(s->fitted,0xFF,sizeof(s->fitted));\r\n}\r\nstatic void remember_channels(prot_state_t *s, const settings_t *cfg)\r\n{\r\n    uint8_t ch;\r\n    memset(s->fitted,0,sizeof(s->fitted));\r\n    for(ch=0;ch<cfg->channel_count;++ch) if(cfg->ch[ch].type!=CH_TYPE_OFF)\r\n        s->fitted[ch/8u]|=(uint8_t)(1u<<(ch%8u));\r\n}\r\nbool prot_begin_pass(prot_state_t *s,const settings_t *cfg)\r\n{\r\n    s->pass_cfg=cfg; s->pass_prepared=true; s->pass_valid=set_validate(cfg)==RES_OK;\r\n    if(s->pass_valid) remember_channels(s,cfg);\r\n    return s->pass_valid;\r\n}\r\nstatic bool newer_result(const prot_state_t *s,uint8_t ch,const scan_out_t *scan)\r\n{\r\n    return (s->latest_seen[ch/8u]&(1u<<(ch%8u))) &&\r\n        (scan==NULL || (int32_t)(s->latest_scan[ch]-scan->scan_no)>0);\r\n}\r\nstatic void first(prot_state_t *s, fault_code_t code, uint8_t channel, uint8_t unit,\r\n                   temp_dC_t value, temp_dC_t threshold, uint32_t uptime)\r\n{\r\n    if(s->first.valid) return;\r\n    s->first.valid=true; s->first.code=code; s->first.channel=channel; s->first.unit=unit;\r\n    s->first.value_dC=value; s->first.threshold_dC=threshold; s->first.uptime_s=uptime;\r\n}\r\nstatic void trip(prot_state_t *s, fault_code_t code, uint8_t channel, uint8_t unit,\r\n                  temp_dC_t value, temp_dC_t threshold, uint32_t uptime)\r\n{\r\n    s->ack_released=false;\r\n    if(s->mode==RUN || s->mode==TRIPPED) {\r\n        first(s,code,channel,unit,value,threshold,uptime); mode_set(s,TRIPPED);\r\n    }\r\n}\r\nbool prot_on_result(prot_state_t *s, uint8_t ch, const result_t *r, const settings_t *cfg,\r\n                    uint32_t scan_no, uint32_t uptime_s)\r\n{\r\n    cond_t cond; act_t act; fault_code_t cause; bool fresh;\r\n    if(s==NULL) return false;\r\n    bool prepared=s->pass_prepared && s->pass_cfg==cfg;\r\n    if(!prot_integrity(s) || cfg==NULL || (prepared?!s->pass_valid:set_validate(cfg)!=RES_OK) || ch>=cfg->channel_count || ch>=MAX_CHANNELS) {\r\n        mode_set(s,TRIPPED); first(s,FC_G04_INTERNAL,0,0,0,0,uptime_s); s->ack_released=false; return true;\r\n    }\r\n    if(!prepared) remember_channels(s,cfg);\r\n    if((s->latest_seen[ch/8u]&(1u<<(ch%8u))) && (int32_t)(scan_no-s->latest_scan[ch])<0) return false;\r\n    cond=chan_cond(r,&cfg->ch[ch],scan_no); act=chan_action(cond,cfg->ch[ch].mode);\r\n    s->latest_scan[ch]=scan_no; s->latest_seen[ch/8u]|=(uint8_t)(1u<<(ch%8u));\r\n    { uint8_t bit=(uint8_t)(1u<<(ch%8u)),byte=(uint8_t)(ch/8u);\r\n      s->alarm_clear[byte]&=(uint8_t)~bit;\r\n      if(chan_alarm_clear(r,&cfg->ch[ch],scan_no)) s->alarm_clear[byte]|=bit;\r\n    }\r\n    cause=chan_cause(r,cond); fresh=act==ACT_TRIP && s->trip_seen[ch]!=(uint8_t)cause;\r\n    if(act!=ACT_NONE) s->alarm_latch[ch]=1;\r\n    if(act==ACT_TRIP) {\r\n        if(fresh || s->mode==RUN) trip(s,cause,(uint8_t)(ch+1u),0,r?r->temp_dC:TEMP_DC_INVALID,cfg->ch[ch].trip_dC,uptime_s);\r\n        s->trip_seen[ch]=(uint8_t)cause;\r\n    } else s->trip_seen[ch]=0;\r\n    return fresh;\r\n}\r\nbool prot_on_fault(prot_state_t *s, fault_registry_t *reg, fault_code_t code,\r\n                   uint8_t unit, ch_mode_t mode, uint8_t channel, uint32_t uptime_s)\r\n{\r\n    bool fresh=fault_raise(reg,code,unit); act_t action=fault_action(code,mode);\r\n    if(s==NULL) return fresh;\r\n    if(!prot_integrity(s) || unit>=FAULT_UNITS || code<1 || code>=FAULT_CODES) {\r\n        mode_set(s,TRIPPED); first(s,FC_G04_INTERNAL,0,0,0,0,uptime_s); s->ack_released=false; return true;\r\n    }\r\n    if(code>=FC_C01_OPEN && code<=FC_C09_RTD && unit<MAX_CHANNELS &&\r\n       !(s->fitted[unit/8u]&(1u<<(unit%8u)))) action=ACT_NONE;\r\n    if((code==FC_G01_SETTINGS_INVALID || code==FC_G10_CALIBRATION) && s->mode!=SERVICE) {\r\n        mode_set(s,CONFIG_LOCK); s->ack_released=false;\r\n    } else if(action==ACT_TRIP && (fresh || s->mode==RUN)) trip(s,code,channel,unit,0,0,uptime_s);\r\n    return fresh;\r\n}\r\nstatic fault_code_t first_fault(const fault_registry_t *reg, uint8_t *unit)\r\n{\r\n    return fault_first_trip(reg,unit);\r\n}\r\nstatic bool fresh_scan(const prot_in_t *in, bool current_settings)\r\n{\r\n    uint8_t i, banks;\r\n    if(in->scan==NULL || in->settings==NULL || !in->scan->scan_validated ||\r\n       (current_settings && in->scan->settings_seq!=in->settings->sequence) ||\r\n       (uint32_t)(in->now_ms-in->scan->completed_ms)>=1000u) return false;\r\n    banks=in->settings->board_type==40?6u:(uint8_t)(in->settings->channel_count/8u);\r\n    for(i=0;i<banks;++i) if(in->scan->bank[i]!=BANK_VALIDATED) return false;\r\n    return true;\r\n}\r\nstatic void clear_alarms(const prot_in_t *in, prot_state_t *s)\r\n{\r\n    uint8_t ch;\r\n    if(in->scan!=NULL && in->settings!=NULL && in->settings->channel_count<=MAX_CHANNELS)\r\n        for(ch=0;ch<in->settings->channel_count;++ch)\r\n            if(newer_result(s,ch,in->scan)?(s->alarm_clear[ch/8u]&(1u<<(ch%8u)))!=0:\r\n               chan_alarm_clear(&in->scan->meas[ch],&in->settings->ch[ch],in->scan->scan_no)) s->alarm_latch[ch]=0;\r\n    fault_ack(in->faults);\r\n}\r\n/* C registry units at this boundary are normalized zero-based channels.\r\n * Acquisition maps a raw CM pin to its channel before publication; the raw pin\r\n * identity belongs in the event value field. */\r\nstatic fault_code_t channel_fault(const fault_registry_t *reg, uint8_t ch, bool latched)\r\n{\r\n    uint8_t code,bit=(uint8_t)(1u<<(ch%8u)),byte=(uint8_t)(ch/8u);\r\n    const uint8_t (*map)[FAULT_BYTES];\r\n    if(reg==NULL || ch>=MAX_CHANNELS) return FC_C01_OPEN;\r\n    map=latched?reg->latch:reg->active;\r\n    for(code=FC_C01_OPEN;code<=FC_C09_RTD;++code) {\r\n        if(code==FC_C04_RATE_RESERVED || code==FC_C05_STUCK_RESERVED) continue;\r\n        if(map[code][byte]&bit) return (fault_code_t)code;\r\n    }\r\n    return FC_NONE;\r\n}\r\nstatic void channel_masks(const fault_registry_t *reg,uint8_t *active,uint8_t *latched)\r\n{\r\n    uint8_t b,c;\r\n    for(b=0;b<(MAX_CHANNELS+7u)/8u;b++) {\r\n        uint8_t a=0,l=0;\r\n        for(c=FC_C01_OPEN;c<=FC_C09_RTD;c++) {\r\n            if(c==FC_C04_RATE_RESERVED || c==FC_C05_STUCK_RESERVED) continue;\r\n            a|=reg->active[c][b]; l|=reg->latch[c][b];\r\n        }\r\n        active[b]=a; latched[b]=l;\r\n    }\r\n}\r\nstatic void ack(const prot_in_t *in, prot_state_t *s, prot_out_t *out, bool cfg_ok)\r\n{\r\n    uint8_t ch, unit=0; fault_code_t cause;\r\n    if(!in->ack) return;\r\n    if(!s->ack_released || in->ack_held_ms<50 || in->ack_age_ms>500) {\r\n        out->ack_reason=ACK_R1_RELEASE; return;\r\n    }\r\n    /* Consume this command: a held key cannot be replayed through this API. */\r\n    s->ack_released=false;\r\n    clear_alarms(in,s);\r\n    if(s->mode==RUN) { out->event_mask|=EVENT_BIT(EV_ACK); return; }\r\n    if(s->mode!=START_LATCHED && s->mode!=TRIPPED) { out->ack_reason=ACK_R5_SETTINGS; return; }\r\n    if(!fresh_scan(in,true)) { out->ack_reason=ACK_R2_SCAN; return; }\r\n    cause=first_fault(in->faults,&unit);\r\n    if(cause!=FC_NONE) {\r\n        out->ack_reason=ACK_R3_FAULT; first(s,cause,0,unit,0,0,in->uptime_s); return;\r\n    }\r\n    for(ch=0;ch<in->settings->channel_count;++ch)\r\n        if(!chan_trip_clear(&in->scan->meas[ch],&in->settings->ch[ch],in->scan->scan_no) ||\r\n           (in->settings->ch[ch].type!=CH_TYPE_OFF && in->settings->ch[ch].mode==CH_MODE_TRIP && channel_fault(in->faults,ch,false)!=FC_NONE)) {\r\n            out->ack_reason=ACK_R4_CHANNEL; out->refusal_channel=(uint8_t)(ch+1u);\r\n            cond_t cond=chan_cond(&in->scan->meas[ch],&in->settings->ch[ch],in->scan->scan_no);\r\n            fault_code_t code=channel_fault(in->faults,ch,false);\r\n            if(code!=FC_NONE || chan_action(cond,in->settings->ch[ch].mode)==ACT_TRIP)\r\n                first(s,code!=FC_NONE?code:chan_cause(&in->scan->meas[ch],cond),\r\n                      (uint8_t)(ch+1u),0,in->scan->meas[ch].temp_dC,in->settings->ch[ch].trip_dC,in->uptime_s);\r\n            return;\r\n        }\r\n    if(!cfg_ok || in->writing) { out->ack_reason=ACK_R5_SETTINGS; return; }\r\n    if(!in->readback_off_ok) { out->ack_reason=ACK_R6_RELAY; return; }\r\n    mode_set(s,RUN); memset(&s->first,0,sizeof(s->first));\r\n    s->accepted_settings_seq=in->settings->sequence; s->replaced_sequence_valid=false;\r\n    memset(s->trip_seen,0,sizeof(s->trip_seen)); clear_alarms(in,s);\r\n    /* Await a new validated scan before starting the pump; expiry still trips. */\r\n    s->window_started_ms=in->now_ms; s->window_valid=false; out->event_mask|=EVENT_BIT(EV_ACK);\r\n}\r\nvoid prot_step(const prot_in_t *in, prot_state_t *s, prot_out_t *out)\r\n{\r\n    bool cfg_ok, cal_ok, was_running; uint8_t ch, unit=0; fault_code_t cause; prot_mode_t before;\r\n    uint8_t active_channels[(MAX_CHANNELS+7u)/8u],latched_channels[(MAX_CHANNELS+7u)/8u];\r\n    if(out==NULL) return;\r\n    memset(out,0,sizeof(*out)); out->alarm_active=true;\r\n    if(in==NULL || s==NULL) return;\r\n    before=s->mode;\r\n    if(!prot_integrity(s)) {\r\n        (void)fault_raise(in->faults,FC_G04_INTERNAL,0);\r\n        mode_set(s,TRIPPED); first(s,FC_G04_INTERNAL,0,0,0,0,in->uptime_s); s->ack_released=false;\r\n    }\r\n    if(!s->pass_prepared || s->pass_cfg!=in->settings) (void)prot_begin_pass(s,in->settings);\r\n    cfg_ok=in->settings_valid && s->pass_valid;\r\n    cal_ok=in->calibration_valid;\r\n    if(s->mode!=SERVICE && (!cfg_ok || !cal_ok)) {\r\n        (void)fault_raise(in->faults,cfg_ok?FC_G10_CALIBRATION:FC_G01_SETTINGS_INVALID,0);\r\n        mode_set(s,CONFIG_LOCK); s->ack_released=false;\r\n    }\r\n    if(in->commit_begin && in->protection_change && s->mode!=SERVICE && s->mode!=CONFIG_LOCK) {\r\n        mode_set(s,START_LATCHED); s->ack_released=false;\r\n    }\r\n    if(in->protection_change && (in->commit_begin || in->commit_done)) memset(s->latest_seen,0,sizeof s->latest_seen);\r\n    if(in->commit_done && cfg_ok && cal_ok) {\r\n        fault_clear(in->faults,FC_G01_SETTINGS_INVALID,0); fault_clear(in->faults,FC_G10_CALIBRATION,0);\r\n        if(s->mode==CONFIG_LOCK || (in->protection_change && s->mode!=SERVICE)) mode_set(s,START_LATCHED);\r\n        if(s->mode==RUN && in->settings->sequence!=s->accepted_settings_seq) {\r\n            s->replaced_settings_seq=s->accepted_settings_seq;\r\n            /* Each save increments by one (05 Â§5). A gap means an unseen save;\r\n             * the last accepted generation is no longer the one just replaced. */\r\n            s->replaced_sequence_valid=(uint32_t)(in->settings->sequence-s->accepted_settings_seq)==1u;\r\n            s->accepted_settings_seq=in->settings->sequence;\r\n        }\r\n        s->ack_released=false;\r\n        out->event_mask|=EVENT_BIT(in->protection_change?EV_SETTINGS_CHANGED:EV_NAME_CHANGED);\r\n    }\r\n    /* Expiry is handled BEFORE accepting a late scan. */\r\n    if(s->mode==RUN && (uint32_t)(in->now_ms-s->window_started_ms)>=WINDOW_MS) {\r\n        (void)prot_on_fault(s,in->faults,FC_G05_SCAN_DEADLINE,0,CH_MODE_TRIP,0,in->uptime_s);\r\n    }\r\n    cause=first_fault(in->faults,&unit);\r\n    if(cause!=FC_NONE && s->mode==RUN) trip(s,cause,0,unit,0,0,in->uptime_s);\r\n    if(in->scan_complete && cfg_ok && in->scan!=NULL) {\r\n        for(ch=0;ch<in->settings->channel_count;++ch) {\r\n            bool had=s->alarm_latch[ch]!=0;\r\n            if(prot_on_result(s,ch,&in->scan->meas[ch],in->settings,in->scan->scan_no,in->uptime_s))\r\n                out->event_mask|=EVENT_BIT(EV_TRIP);\r\n            if(!had && s->alarm_latch[ch]) out->event_mask|=EVENT_BIT(EV_ALARM);\r\n        }\r\n    }\r\n    if(cfg_ok && in->faults!=NULL) channel_masks(in->faults,active_channels,latched_channels);\r\n    else { memset(active_channels,0xFF,sizeof active_channels); memset(latched_channels,0xFF,sizeof latched_channels); }\r\n    if(cfg_ok && in->settings!=NULL) for(ch=0;ch<in->settings->channel_count;++ch) {\r\n        const chan_cfg_t *c=&in->settings->ch[ch];\r\n        if(c->type==CH_TYPE_OFF) continue;\r\n        if(active_channels[ch/8u]&(1u<<(ch%8u))) {\r\n            fault_code_t code=channel_fault(in->faults,ch,false);\r\n            s->alarm_latch[ch]=1;\r\n            if(c->mode==CH_MODE_TRIP && s->mode==RUN) trip(s,code,(uint8_t)(ch+1u),0,0,0,in->uptime_s);\r\n        }\r\n        if(in->scan!=NULL && !newer_result(s,ch,in->scan) && chan_action(chan_cond(&in->scan->meas[ch],c,in->scan->scan_no),c->mode)!=ACT_NONE)\r\n            s->alarm_latch[ch]=1;\r\n    }\r\n    if(in->ack_key_released && !in->ack) s->ack_released=true;\r\n    was_running=s->mode==RUN;\r\n    ack(in,s,out,cfg_ok && cal_ok);\r\n    if(in->ack && in->faults!=NULL) channel_masks(in->faults,active_channels,latched_channels);\r\n    /* Only an observed names-only commit permits one replaced scan generation.\r\n     * ACK's completion belongs to the preceding state, never to its new window. */\r\n    if(was_running && s->mode==RUN && in->scan_complete && fresh_scan(in,false) &&\r\n       in->settings->sequence==s->accepted_settings_seq &&\r\n       (in->scan->settings_seq==s->accepted_settings_seq ||\r\n        (s->replaced_sequence_valid && in->scan->settings_seq==s->replaced_settings_seq)) &&\r\n       cause==FC_NONE && in->flow_ok) {\r\n        s->window_valid=true; s->window_started_ms=in->now_ms; out->window_refresh=true;\r\n        if(in->scan->settings_seq==s->accepted_settings_seq) s->replaced_sequence_valid=false;\r\n    }\r\n    out->run_permission=prot_integrity(s) && s->mode==RUN && cfg_ok && cal_ok &&\r\n        cause==FC_NONE && in->flow_ok;\r\n    if(out->run_permission && s->window_valid && (uint32_t)(in->now_ms-s->window_started_ms)<WINDOW_MS)\r\n        out->window_remaining_ms=(uint16_t)(WINDOW_MS-(uint32_t)(in->now_ms-s->window_started_ms));\r\n    out->alarm_active=s->mode!=RUN || !cfg_ok || !cal_ok || !in->flow_ok || fault_global_alarm_latched(in->faults);\r\n    if(cfg_ok) for(ch=0;ch<in->settings->channel_count;++ch)\r\n        if(in->settings->ch[ch].type!=CH_TYPE_OFF &&\r\n           (s->alarm_latch[ch] || (latched_channels[ch/8u]&(1u<<(ch%8u))))) out->alarm_active=true;\r\n    if(before!=TRIPPED && s->mode==TRIPPED) out->event_mask|=EVENT_BIT(EV_TRIP);\r\n    s->pass_prepared=false;\r\n}\r\n#include \"services/scan.h\"\r\n#include \"app/acquisition_budget.h\"\r\n#include \"app/cj_schedule.h\"\r\n#include \"services/tc_math.h\"\r\n#include \"drivers/ad7124.h\"\r\n#include \"drivers/tmp126.h\"\r\n#include \"mcal/gpio.h\"\r\n#include \"mcal/timer.h\"\r\n#include \"mcal/wdt.h\"\r\n#include \"board/board_cfg.h\"\r\n#include <string.h>\r\ntypedef enum { INIT_ADC, INIT_CJ, WAIT_CJ, REF_PRE, REF_HIGH, REF_LOW,\r\n               BEGIN_SCAN, READ_CJ, START_SLOT, POLL_SLOT, END_SCAN, RECOVER } phase_t;\r\nstatic phase_t phase;\r\nstatic scan_out_t work,published;\r\nstatic scan_diag_t diag;\r\nstatic const settings_t *cfg;\r\nstatic const calibration_t *cal;\r\nstatic fault_registry_t *registry;\r\nstatic uint32_t start,progress,wait_start,pending,last_ref;\r\nstatic uint8_t initialized,slot,done,cj_index,end_index;\r\nstatic bool prior[MAX_BANKS],good[MAX_BANKS],verify_done[MAX_BANKS],reinit,transport[MAX_BANKS];\r\nstatic int32_t cj_mC[10];\r\nstatic bool cj_valid[10];\r\nstatic uint16_t cm_bad[MAX_BANKS];\r\nstatic void raise(fault_code_t f,uint8_t u) { if(registry && f!=FC_NONE) (void)fault_raise(registry,f,u); }\r\nstatic void bank_fault(uint8_t b,fault_code_t f) {\r\n    if(f==FC_NONE) f=FC_B05_ADC_STALLED;\r\n    good[b]=false; if(f!=FC_B06_REF) diag.cal_safe[b]=false; raise(f,b);\r\n}\r\nemf_nV_t scan_emf(uint32_t code,uint8_t gain) {\r\n    int64_t d=(int32_t)code-0x800000L;\r\n    /* Symmetric nearest rounding; avoids implementation-dependent negative shifts. */\r\n    int64_t n=d*2500000000LL,div=(int64_t)gain*8388608L;\r\n    n=n>=0?(n+div/2)/div:-((-n+div/2)/div);\r\n    if(n>INT32_MAX) return INT32_MAX;\r\n    if(n<INT32_MIN) return INT32_MIN;\r\n    return (emf_nV_t)n;\r\n}\r\nfault_code_t scan_limit(uint8_t s,uint32_t code,uint32_t partner,int32_t ref,\r\n                       int32_t baseline,uint32_t tc) {\r\n    int32_t d=(int32_t)code-0x800000L,v=scan_emf(code,s==11 || s==12?1:32);\r\n    int32_t other; int64_t diff;\r\n    switch(s) {\r\n    case 8: { /* OPEN-Q9: +/-1.6% from production ratio */\r\n        int64_t nominal=6990507LL*(1000000LL+ref)/1000000LL;\r\n        if(ref==CAL_MISSING || ref < -10000 || ref>10000 ||\r\n           (int64_t)d*1000<nominal*984 || (int64_t)d*1000>nominal*1016) return FC_B06_REF;\r\n        break;\r\n    }\r\n    case 9: if(v < -50000 || v>50000) return FC_B08_ZERO; break;\r\n    case 10: if(v<15000000 || v>25000000) return FC_B09_GAIN; break;\r\n    case 11:\r\n        other=scan_emf(partner,32); diff=(int64_t)other-v;\r\n        if(v<=0 || (int64_t)diff*1000 < -(int64_t)v*5 || (int64_t)diff*1000>(int64_t)v*5) return FC_B09_GAIN;\r\n        break;\r\n    case 12: /* AVDD=6*V; compare without overflowing int32. */\r\n        if((int64_t)v*6<3150000000LL || (int64_t)v*6>3450000000LL) return FC_B07_AVDD;\r\n        break;\r\n    case 13: if(d*20LL<8388608LL || d*20LL>19LL*8388608LL) return FC_C03_COMMON_MODE; break;\r\n    case 14:\r\n        if(d>=7549748L) return FC_C01_OPEN;\r\n        if(baseline==CAL_MISSING) return FC_G10_CALIBRATION; /* OPEN-Q10: lock, never invent baseline */\r\n        diff=v-scan_emf(tc,32);\r\n        if((int64_t)diff>2LL*baseline) return FC_C01_OPEN;\r\n        if(2LL*diff<baseline) return FC_C06_SHORTED;\r\n        break;\r\n    default: if(d<=-8220836L || d>=8220836L) return FC_C02_RANGE; break;\r\n    }\r\n    return FC_NONE; /* All diagnostic windows provisional: 03 section 4. */\r\n}\r\nvoid scan_restart(void) {\r\n    phase=INIT_ADC; initialized=0; cj_index=0; reinit=false; diag.initialized=false;\r\n    diag.ref_test_ok=false; wait_start=tick_ms(); ad_reset_state(); cj_reset();\r\n    memset(prior,0,sizeof prior); gpio_write(board()->reftest,false);\r\n}\r\nvoid scan_init(const settings_t *s,const calibration_t *c,fault_registry_t *r) {\r\n    cfg=s; cal=c; registry=r; memset(&published,0,sizeof published); memset(&work,0,sizeof work);\r\n    memset(cm_bad,0,sizeof cm_bad);\r\n    memset(&diag,0,sizeof diag); pending=0; progress=tick_ms(); last_ref=tick_ms(); scan_restart();\r\n}\r\nstatic void publish(void) {\r\n    uint8_t b,c; bool all=true,all_transport=true,all_fault=true;\r\n    work.scan_validated=true;\r\n    for(b=0;b<board()->banks;b++) {\r\n        work.bank[b]=good[b]?BANK_VALIDATED:BANK_FAULT; all&=good[b]; all_transport&=transport[b]; all_fault&=!good[b];\r\n        prior[b]=good[b];\r\n    }\r\n    if(all_transport || (gpio_read(board()->refok) && all_fault)) { raise(FC_G14_ISLAND_LOST,0); reinit=true; }\r\n    if(gpio_read(board()->refok)) { raise(FC_G08_ENGREF_LOST,0); all=false; }\r\n    diag.duration_ms=(uint16_t)(tick_ms()-start);\r\n    if(tick_ms()-start>1000) { raise(FC_G05_SCAN_DEADLINE,0); all=false; }\r\n    if(!fuses_ok()) { raise(FC_G15_FUSES,0); all=false; }\r\n    if(registry && fault_active(registry,FC_G15_FUSES)) all=false;\r\n    work.scan_validated=all && diag.ref_test_ok && !reinit;\r\n    for(b=0;b<board()->banks;b++) diag.cal_safe[b]&=diag.registers_ok[b] && !reinit;\r\n    work.completed_ms=tick_ms();\r\n    /* Bad bank diagnostics revoke current validity; channel failures do not invalidate its bank. */\r\n    for(c=0;c<board()->channels;c++) if(!good[board()->channel[c].bank]) work.meas[c].flags&=0xFE;\r\n    published=work;\r\n    if(work.scan_validated && registry) {\r\n        fault_clear(registry,FC_G05_SCAN_DEADLINE,0); fault_clear(registry,FC_G08_ENGREF_LOST,0);\r\n        fault_clear(registry,FC_G14_ISLAND_LOST,0);\r\n    }\r\n    phase=reinit?RECOVER:BEGIN_SCAN; wait_start=tick_ms(); progress=tick_ms();\r\n}\r\nstatic void channel_fault(uint8_t ch,fault_code_t f) {\r\n    uint8_t flag=0;\r\n    switch(f) {\r\n    case FC_C01_OPEN:flag=MEAS_OPEN;break; case FC_C02_RANGE:flag=MEAS_RANGE;break;\r\n    case FC_C03_COMMON_MODE:flag=MEAS_CM_FAIL;break; case FC_C06_SHORTED:flag=MEAS_SHORTED;break;\r\n    case FC_C07_OVUV:flag=MEAS_OVUV;break; case FC_C08_COLD:flag=MEAS_COLD;break;\r\n    default:break;\r\n    }\r\n    work.meas[ch].flags=(uint8_t)((work.meas[ch].flags&~MEAS_VALID)|flag);\r\n    if(f!=FC_C03_COMMON_MODE) raise(f,ch); /* C03 registry unit is the physical input pin. */\r\n}\r\nstatic void result(uint8_t b,uint32_t code) {\r\n    uint8_t ch=(uint8_t)(8*b+slot),target=(uint8_t)(8*b+work.scan_no%8);\r\n    fault_code_t f=ad_fault(b),limit; int32_t base=CAL_MISSING,ref=CAL_MISSING;\r\n    diag.raw[b][slot]=code;\r\n    if(slot==8 && f!=FC_NONE) diag.cal_safe[b]=false;\r\n    if(cal) { ref=cal->ref_ppm[b];\r\n        if(cfg && cal->tag[target]==(uint8_t)((cfg->ch[target].type_epoch<<2)|cfg->ch[target].type)) base=cal->baseline_nV[target];\r\n    }\r\n    if(f>=FC_B01_ADC_ID && f<=FC_B15_ADC_RESET) bank_fault(b,f);\r\n    else if(f!=FC_NONE) channel_fault(slot<8?ch:slot==13?(uint8_t)(8*b+(work.scan_no%16)/2):target,f);\r\n    limit=scan_limit(slot,code,diag.raw[b][10],ref,base,diag.raw[b][work.scan_no%8]);\r\n    if(limit>=FC_B01_ADC_ID && limit<=FC_B15_ADC_RESET) bank_fault(b,limit);\r\n    /* OFF has no learned baseline/tag (05 Â§6). Its burnout result cannot\r\n     * lock a partially fitted board; REF calibration remains mandatory. */\r\n    if(slot==14 && cfg && cfg->ch[target].type==CH_TYPE_OFF) limit=FC_NONE;\r\n    if(limit==FC_G10_CALIBRATION) raise(limit,0);\r\n    if(slot<8) {\r\n        result_t *m=&work.meas[ch];\r\n        m->scan_no=work.scan_no; m->emf_nV=scan_emf(code,32); m->temp_dC=TEMP_DC_INVALID;\r\n        /* Advisory CM/burn flags persist until their next scheduled check. */\r\n        m->flags&=(MEAS_CM_FAIL|MEAS_OPEN|MEAS_SHORTED);\r\n        if(limit!=FC_NONE) channel_fault(ch,limit);\r\n        else if(f!=FC_NONE) channel_fault(ch,f);\r\n        else if(good[b] && cj_valid[2*b] && cj_valid[2*b+1]) {\r\n            uint16_t w=board()->channel[ch].cj_weight_q8;\r\n            int32_t cj=cj_mC[2*b]+(int32_t)(((int64_t)(cj_mC[2*b+1]-cj_mC[2*b])*w)/256);\r\n            ch_type_t type=cfg?cfg->ch[ch].type:CH_TYPE_K;\r\n            uint8_t flags=tc_convert(type,m->emf_nV,(temp_dC_t)(cj/100),&m->temp_dC);\r\n            m->flags|=(uint8_t)(flags&~MEAS_VALID);\r\n            if(prior[b] && (flags&MEAS_VALID) && !(m->flags&~MEAS_VALID)) m->flags|=MEAS_VALID;\r\n            if(flags&MEAS_COLD) raise(FC_C08_COLD,ch);\r\n            if(flags&MEAS_RANGE) raise(FC_C02_RANGE,ch);\r\n            if(registry && !(flags&MEAS_RANGE)) fault_clear(registry,FC_C02_RANGE,ch);\r\n            if(registry && !(flags&MEAS_COLD)) fault_clear(registry,FC_C08_COLD,ch);\r\n            if(registry) fault_clear(registry,FC_C07_OVUV,ch);\r\n        }\r\n        pending|=1UL<<ch;\r\n    } else if(slot==13) {\r\n        uint8_t input=(uint8_t)(work.scan_no%16);\r\n        uint16_t bit=(uint16_t)(1u<<input);\r\n        target=(uint8_t)(8*b+(work.scan_no%16)/2);\r\n        if(limit!=FC_NONE || f==FC_C03_COMMON_MODE) { cm_bad[b]|=bit; channel_fault(target,FC_C03_COMMON_MODE); raise(FC_C03_COMMON_MODE,target); }\r\n        else { cm_bad[b]&=(uint16_t)~bit; }\r\n        /* One registry unit per owning channel, retaining both physical pin\r\n         * bits until each clears. Raw pin identity remains in scan_no % 16. */\r\n        if(registry && !(cm_bad[b]&(uint16_t)(3u<<(2*(input/2))))) fault_clear(registry,FC_C03_COMMON_MODE,target);\r\n        if(!(cm_bad[b]&(uint16_t)(3u<<(2*(input/2))))) work.meas[target].flags&=0xF7;\r\n    } else if(slot==14) {\r\n        diag.burnout_nV[target]=scan_emf(code,32)-scan_emf(diag.raw[b][work.scan_no%8],32);\r\n        if(limit==FC_C01_OPEN || limit==FC_C06_SHORTED) channel_fault(target,limit);\r\n        else if(limit==FC_NONE && f==FC_NONE) { work.meas[target].flags&=0xED;\r\n            if(registry) { fault_clear(registry,FC_C01_OPEN,target); fault_clear(registry,FC_C06_SHORTED,target); }\r\n        }\r\n    }\r\n}\r\nvoid scan_task(void) {\r\n    uint8_t b; res_t r; uint32_t code=0;\r\n    switch(phase) {\r\n    case INIT_ADC:\r\n        for(b=0;b<board()->banks;b++) if(!(initialized&(1u<<b))) {\r\n            r=ad_init(b);\r\n            if(r==RES_OK) initialized|=(uint8_t)(1u<<b);\r\n            else if(r!=RES_BUSY) { raise(ad_fault(b),b); phase=RECOVER; wait_start=tick_ms(); }\r\n        }\r\n        progress=tick_ms();\r\n        if(initialized==(1u<<board()->banks)-1u) { phase=INIT_CJ; cj_index=0; }\r\n        break;\r\n    case INIT_CJ:\r\n        r=cj_init(cj_index); progress=tick_ms();\r\n        if(r!=RES_OK) { raise(FC_B10_CJ_BOTH,(uint8_t)(cj_index/2)); phase=RECOVER; wait_start=tick_ms(); }\r\n        else if(++cj_index==board()->cj_count) { phase=WAIT_CJ; wait_start=tick_ms(); }\r\n        break;\r\n    case WAIT_CJ: if(tick_ms()-wait_start>=8) { diag.initialized=true; phase=REF_PRE; progress=tick_ms(); } break;\r\n    case REF_PRE:\r\n        if(gpio_read(board()->refok)) { raise(FC_G08_ENGREF_LOST,0); diag.ref_test_ok=false; phase=BEGIN_SCAN; }\r\n        else { gpio_write(board()->reftest,true); phase=REF_HIGH; wait_start=tick_ms(); }\r\n        progress=tick_ms(); break;\r\n    case REF_HIGH:\r\n        if(tick_ms()-wait_start>=5) { /* OPEN-H7: RC-estimated waits, 10 min interval */\r\n            diag.ref_test_ok=gpio_read(board()->refok);\r\n            if(!diag.ref_test_ok) raise(FC_G09_ENGREF_TEST,0);\r\n            gpio_write(board()->reftest,false); phase=REF_LOW; wait_start=tick_ms(); progress=tick_ms();\r\n        } break;\r\n    case REF_LOW:\r\n        if(tick_ms()-wait_start>=20) {\r\n            if(gpio_read(board()->refok)) { raise(FC_G08_ENGREF_LOST,0); diag.ref_test_ok=false; }\r\n            if(diag.ref_test_ok && registry) fault_clear(registry,FC_G09_ENGREF_TEST,0);\r\n            last_ref=tick_ms(); diag.initialized=true; phase=BEGIN_SCAN; progress=tick_ms();\r\n        } break;\r\n    case BEGIN_SCAN:\r\n        if(tick_ms()-last_ref>=600000UL) { phase=REF_PRE; break; }\r\n        start=tick_ms(); ++work.scan_no; work.scan_validated=false; work.settings_seq=cfg?cfg->sequence:0;\r\n        for(b=0;b<board()->banks;b++) {\r\n            good[b]=true; transport[b]=false; verify_done[b]=false; diag.cal_safe[b]=true; diag.registers_ok[b]=false;\r\n            ad_scan_begin(b,work.scan_no);\r\n            if(ad_fault(b)!=FC_NONE) { bank_fault(b,ad_fault(b)); reinit=true; }\r\n        }\r\n        cj_index=end_index=0; phase=reinit?END_SCAN:READ_CJ; break;\r\n    case READ_CJ:\r\n        r=cj_read_step(cj_index,&cj_mC[cj_index]); progress=tick_ms();\r\n        if(r==RES_BUSY) break;\r\n        diag.cj_status[cj_index]=r; cj_valid[cj_index]=r==RES_OK;\r\n        if(++cj_index<board()->cj_count) break;\r\n        for(b=0;b<board()->banks;b++) {\r\n            int32_t diff=cj_mC[2*b]-cj_mC[2*b+1];\r\n            work.cj_dC[b][0]=(temp_dC_t)(cj_mC[2*b]/100); work.cj_dC[b][1]=(temp_dC_t)(cj_mC[2*b+1]/100);\r\n            if(!cj_valid[2*b] && !cj_valid[2*b+1]) bank_fault(b,FC_B10_CJ_BOTH);\r\n            else if(!cj_valid[2*b] || !cj_valid[2*b+1]) bank_fault(b,FC_B12_CJ_ONE);\r\n            else if(diff < -3000 || diff>3000) bank_fault(b,FC_B11_CJ_DIFF); /* OPEN-Q13 */\r\n        }\r\n        slot=0; phase=START_SLOT; break;\r\n    case START_SLOT:\r\n        done=0;\r\n        for(b=0;b<board()->banks;b++) {\r\n            r=ad_start_slot(b,slot);\r\n            if(r!=RES_OK) { bank_fault(b,ad_fault(b)); transport[b]=r==RES_ERR_CRC || r==RES_ERR_ID; reinit=true; }\r\n        }\r\n        progress=tick_ms(); phase=reinit?END_SCAN:POLL_SLOT; break;\r\n    case POLL_SLOT:\r\n        for(b=0;b<board()->banks;b++) if(!(done&(1u<<b))) {\r\n            r=ad_poll(b,&code);\r\n            if(r==RES_OK) { result(b,code); done|=(uint8_t)(1u<<b); }\r\n            else if(r!=RES_BUSY) { bank_fault(b,ad_fault(b)); transport[b]=r==RES_ERR_CRC || r==RES_ERR_ID; reinit=true; done|=(uint8_t)(1u<<b); }\r\n            progress=tick_ms();\r\n            if(!verify_done[b] && !reinit) { r=ad_verify(b);\r\n                if(r==RES_OK) verify_done[b]=true;\r\n                else if(r!=RES_BUSY) { bank_fault(b,ad_fault(b)); reinit=true; }\r\n            }\r\n        }\r\n        if(reinit) { phase=END_SCAN; break; }\r\n        if(done==(1u<<board()->banks)-1u) { if(++slot==15) phase=END_SCAN; else phase=START_SLOT; }\r\n        break;\r\n    case END_SCAN:\r\n        if(!reinit) for(b=0;b<board()->banks;b++) {\r\n            r=ad_verify_mutable_part(b,end_index); diag.registers_ok[b]=r==RES_OK && verify_done[b];\r\n            if(!diag.registers_ok[b]) {\r\n                bank_fault(b,ad_fault(b)); transport[b]=r==RES_ERR_CRC || r==RES_ERR_ID; reinit=true;\r\n            }\r\n            if(end_index==18 && good[b] && registry) { uint8_t f; for(f=FC_B01_ADC_ID;f<=FC_B15_ADC_RESET;f++) fault_clear(registry,(fault_code_t)f,b); }\r\n        }\r\n        if(!reinit && ++end_index<19) { progress=tick_ms(); break; }\r\n        publish(); break;\r\n    case RECOVER:\r\n        if(tick_ms()-wait_start>=10) { scan_restart(); progress=tick_ms(); }\r\n        break;\r\n    default: raise(FC_G04_INTERNAL,0); scan_restart(); break;\r\n    }\r\n}\r\nconst scan_out_t *scan_last(void) { return &published; }\r\nconst scan_out_t *scan_current(void) { return &work; }\r\nconst scan_diag_t *scan_diagnostics(void) { return &diag; }\r\nuint32_t scan_progress_ms(void) { return progress; }\r\nuint32_t scan_take_results(void) { uint32_t v=pending; pending=0; return v; }\r\n","exit_code":0,"status":"completed"}}
